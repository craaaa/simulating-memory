*.pem
*.key
credentials.json
secrets.json

# Logs and tmp outputs
*.log
.tmp/
tmp/
# Everything under logs/, which subsumes the API error dumps (11k+ files) that used
# to be listed separately as logs/llm_openai_errors/. The 168 legacy error dumps
# committed before this rule stay tracked -- ignoring a path does not untrack it.
logs/

# STaR raw sample pools: every row repeats the full ~1.5KB prompt, so these run to
# ~17MB per round. The accepted corpus, evals, figures and cost ledger ARE committed;
# pools can be regenerated with `star --resume`.
rationales/out/**/sample_pool.jsonl
rationales/out/spend_ledger.jsonl.bak

# merge_repeat_batch pre-merge backups
*.bak_n5
tasks_bak_n5/

# Pre-reparse pool backups: same ~100MB as the pool itself, and the pool is
# already ignored. reparse_pool writes these next to it.
rationales/out/**/sample_pool.jsonl.bak

ut the study you found notable or wanted to let us know about? For example: comments about the passage and\/or narration, how challenging the questions were, any distractions or technical issues, or anything else.","DefaultChoices":false,"DataExportTag":"Q35","QuestionType":"TE","Selector":"ML","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Is there anything about the study you found notable or wanted to let us know about? For example:...","Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"QuestionID":"QID50"}},{"SurveyID":"SV_9RfCnFkO7qKjVky","Element":"SQ","PrimaryAttribute":"QID51","SecondaryAttribute":"On a scale of 0 (easy) to 10 (difficult), how difficult did you find the questions?","TertiaryAttribute":null,"Payload":{"QuestionText":"On a scale of 0 (easy) to 10 (difficult), how difficult did you find the questions?","DefaultChoices":false,"DataExportTag":"Q23","QuestionID":"QID51","QuestionType":"SS","Selector":"TA","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"above"},"QuestionDescription":"On a scale of 0 (easy) to 10 (difficult), how difficult did you find the questions?","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON"}},"GradingData":[],"Language":[],"NextChoiceId":12,"NextAnswerId":1,"Category":"Gauges","Scale":"TenGauge","Choices":[{"Display":"0"},{"Display":1},{"Display":2},{"Display":3},{"Display":4},{"Display":5},{"Display":6},{"Display":7},{"Display":8},{"Display":9},{"Display":10}]}},{"SurveyID":"SV_9RfCnFkO7qKjVky","Element":"SQ","PrimaryAttribute":"QID52","SecondaryAttribute":"Let's ensure your audio is working! Make sure that you can hear the following audio clip, then se...","TertiaryAttribute":null,"Payload":{"QuestionText":"<p>Let's ensure your audio is working!<\/p><p><br><\/p><p>Make sure that you can hear the following audio clip, then select the appropriate answer(s) below.<\/p>\n\n<div style=\"text-align: center;\">\n<audio class=\"qmedia\" controls=\"true\" height=\"40\" preload=\"auto\" width=\"320\"><source src=\"https:\/\/nyu.qualtrics.com\/CP\/File.php?F=F_2hq7EqZGgsafYkS\" type=\"audio\/wav\"><\/audio>\n<\/div>","DefaultChoices":false,"DataExportTag":"audio check","QuestionID":"QID52","QuestionType":"MC","Selector":"MAVR","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","NumColumns":2,"LabelPosition":"BELOW"},"QuestionDescription":"Let's ensure your audio is working! Make sure that you can hear the following audio clip, then se...","Choices":{"4":{"Display":"412"},"5":{"Display":"28"},"6":{"Display":"-356"},"7":{"Display":"7"}},"ChoiceOrder":["4","5","6","7"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None","MinChoices":"1"}},"GradingData":[],"Language":[],"NextChoiceId":8,"NextAnswerId":1,"SubSelector":"TX"}},{"SurveyID":"SV_9RfCnFkO7qKjVky","Element":"SQ","PrimaryAttribute":"QID53","SecondaryAttribute":"Click 'Start' to begin the experiment.","TertiaryAttribute":null,"Payload":{"QuestionText":"Click 'Start' to begin the experiment.","DefaultChoices":false,"DataExportTag":" ","QuestionID":"QID53","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Click 'Start' to begin the experiment.","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1}},{"SurveyID":"SV_9RfCnFkO7qKjVky","Element":"SQ","PrimaryAttribute":"QID56","SecondaryAttribute":"Which of the following statements describe the ashen skreel's plumage? Select all that apply.","TertiaryAttribute":null,"Payload":{"QuestionText":"Which of the following statements descri
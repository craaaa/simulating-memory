ancePages":false,"QuestionsPerPage":"","PageTransition":"none","EOSMessage":null,"ShowExportTags":"false","CollectGeoLocation":"false","PasswordProtection":"No","AnonymizeResponse":"No","RefererCheck":"No","BallotBoxStuffingPreventionBehavior":null,"BallotBoxStuffingPreventionMessage":null,"BallotBoxStuffingPreventionMessageLibrary":null,"BallotBoxStuffingPreventionURL":null,"RecaptchaV3":"false","ConfirmStart":false,"AutoConfirmStart":false,"RelevantID":"false","RelevantIDLockoutPeriod":"+30 days","UseCustomSurveyLinkCompletedMessage":null,"SurveyLinkCompletedMessage":null,"SurveyLinkCompletedMessageLibrary":null,"ResponseSummary":"No","EOSMessageLibrary":null,"EOSRedirectURL":"https:\/\/app.prolific.com\/submissions\/complete?cc=CMFQ702S","EmailThankYou":"false","ThankYouEmailMessageLibrary":null,"ThankYouEmailMessage":null,"ValidateMessage":"false","ValidationMessageLibrary":null,"InactiveSurvey":"DefaultMessage","PartialDeletion":null,"PartialDataCloseAfter":"LastActivity","InactiveMessageLibrary":null,"InactiveMessage":null,"AvailableLanguages":{"EN":[]},"headerMid":"","SurveyName":"QA Pilot v4","ProtectSelectionIds":true}},{"SurveyID":"SV_9RfCnFkO7qKjVky","Element":"SQ","PrimaryAttribute":"QID10","SecondaryAttribute":"Do you consent to participate in this study?","TertiaryAttribute":null,"Payload":{"QuestionText":"Do you consent to participate in this study?","DefaultChoices":false,"DataExportTag":"Consent","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Do you consent to participate in this study?","Choices":{"1":{"Display":"I consent"},"2":{"Display":"I do not consent"}},"ChoiceOrder":[1,2],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":3,"NextAnswerId":1,"QuestionID":"QID10"}},{"SurveyID":"SV_9RfCnFkO7qKjVky","Element":"SQ","PrimaryAttribute":"QID16","SecondaryAttribute":"Instructions Please complete this task in one sitting without writing anything down or using outs...","TertiaryAttribute":null,"Payload":{"QuestionText":"<h2>Instructions<\/h2>\n\n<p>Please complete this task in one sitting <strong>without writing anything down<\/strong> or using outside resources.<\/p>\n\n<p>&nbsp;<\/p>\n\n<p>You will listen to a passage of text describing multiple bird species. You will then answer some questions about the contents of the text. Do your best to answer accurately, but don&#39;t worry if you are unsure about any answers. Some questions may be more difficult to answer than others.<\/p>","DefaultChoices":false,"DataExportTag":"intro","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Instructions Please complete this task in one sitting without writing anything down or using outs...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID16"}},{"SurveyID":"SV_9RfCnFkO7qKjVky","Element":"SQ","PrimaryAttribute":"QID17","SecondaryAttribute":"Loading...","TertiaryAttribute":null,"Payload":{"QuestionText":"Loading...","DefaultChoices":false,"DataExportTag":"Trial","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Loading...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID17","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function () {\n    if (window._audioQuestionLoaded) return;\n    window._audioQuestionLoaded = true;\n    var qthis = this;\n\n    var STIMULI = {\n        \"control\":             { \"url\": \"https:\/\/craaaa.github.io\/simulating-memory\/pilot_v4\/audio\/control.mp3\" },\n        \"distractor\": { \"url\": \"https:\/\/craaaa.github.io\/simulating-memory\/pilot_v4\/audio\/distractor.mp3\" },\n        \"repeat_long\":      { \"url\": \"https:\/\/craaaa.github.io\/simulating-memory\/pilot_v4\/audio\/repeat_long.mp3\" },\n        \"repeat_short\":      { \"url\": \"https:\/\/craaaa.github.io\/simulating-memory\/pilot_v4\/audio\/repeat_short.mp3\" },\n    };\n\n    var docId = \"${e:\/\/Field\/assigned_doc}\";\n    var doc = STIMULI[docId];\n\n    if (!doc || !doc.url) {\n        qthis.getQuestionContainer().innerHTML =\n            \"<p>Configuration error: missing audio for condition=\" + docId +\n            \". Please return this study on Prolific.<\/p>\";\n        return;\n    }\n\n    qthis.hideNextButton();\n\n    var container = qthis.getQuestionContainer();\n    container.innerHTML =\n        '<div id=\"audio-status\" style=\"text-align:center;font-weight:bold;margin-bottom:12px;\">Loading audio\u2026<\/div>' +\n        '<div id=\"audio-start-wrap\" style=\"text-align:center;margin-bottom:12px;\"><\/div>' +\n        '<div id=\"audio-progress\" style=\"text-align:center;color:#666;margin-bottom:12px;\"><\/div>';\n\n    var statusEl   = document.getElementById(\"audio-status\");\n    var startWrap  = document.getElementById(\"audio-start-wrap\");\n    var progressEl = document.getElementById(\"audio-progress\");\n\n    var audio = new Audio(doc.url);\n    audio.preload = \"auto\";\n    audio.loop    = false;\n\n    audio.addEventListener(\"contextmenu\", function (e) { e.preventDefault(); });\n\n    var startTime = null;\n    var progressIv = null;\n\n    function beginPlayback() {\n        startTime = Date.now();\n        startWrap.innerHTML = \"\";\n        statusEl.textContent = \"Audio is playing. Please listen carefully.\";\n\n        progressIv = setInterval(function () {\n            if (!isNaN(audio.duration) && audio.duration > 0) {\n                var remaining = Math.ceil(audio.duration - audio.currentTime);\n                progressEl.textContent = remaining > 0 ? remaining + \"s remaining\" : \"\";\n            }\n        }, 1000);\n\n        audio.play();\n    }\n\n    audio.addEventListener(\"canplaythrough\", function () {\n        statusEl.textContent = \"Audio loaded. When you are ready, click to start listening.\";\n        startWrap.innerHTML =\n            '<button id=\"audio-start-btn\" style=\"font-size:1em;padding:8px 24px;\">\u25b6 Start Audio<\/button>';\n        document.getElementById(\"audio-start-btn\").addEventListener(\"click\", function () {\n            document.getElementById(\"audio-start-btn\").disabled = true;\n            beginPlayback();\n        });\n    }, { once: true });\n\n    audio.addEventListener(\"ended\", function () {\n        if (progressIv) { clearInterval(progressIv); }\n        var rt = startTime ? (Date.now() - startTime) : null;\n        Qualtrics.SurveyEngine.setEmbeddedData(\"listening_rt\", rt);\n        Qualtrics.SurveyEngine.setEmbeddedData(\"listening_completed\", \"true\");\n        statusEl.textContent  = \"Audio complete. Click Next to continue.\";\n        progressEl.textContent = \"\";\n        qthis.showNextButton();\n        \/\/ Audio is finished and not looped \u2014 no replay possible without page reload.\n    });\n\n    audio.addEventListener(\"error\", function () {\n        if (progressIv) { clearInterval(progressIv); }\n        statusEl.textContent =\n            \"Audio failed to load. Please return this study on Prolific.\";\n    });\n});\n\nQualtrics.SurveyEngine.addOnUnload(function () {\n    \/\/ No-op; cleanup handled in ended\/error handlers above.\n});"}},{"SurveyID":"SV_9RfCnFkO7qKjVky","Element":"SQ","PrimaryAttribute":"QID29","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"DataExportTag":"Trial Timing","QuestionType":"Timing","Selector":"PageTimer","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"GradingData":[],"Language":[],"NextChoiceId":44,"NextAnswerId":1,"QuestionID":"QID29"}},{"SurveyID":"SV_9RfCnFkO7qKjVky","Element":"SQ","PrimaryAttribute":"QID3","SecondaryAttribute":"Informed Consent Form IRB-FY2020-4512 Title: \u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0","TertiaryAttribute":null,"Payload":{"QuestionText":"<div class=\"WordSection1\"><p class=\"MsoNormal\" align=\"center\" style=\"text-align:center;background:#D9D9D9;\nmso-shading:windowtext;mso-pattern:gray-15 auto\"><b style=\"mso-bidi-font-weight:\nnormal\"><span lang=\"EN-GB\" style=\"font-size:14.0pt;mso-bidi-font-size:10.0pt;\ncolor:black;mso-color-alt:windowtext\">Informed Consent Form IRB-FY2020-4512<\/span><\/b><b style=\"mso-bidi-font-weight:normal\"><span lang=\"EN-GB\" style=\"font-size:14.0pt;\nmso-bidi-font-size:10.0pt\"><\/span><\/b><\/p>\n\n<p class=\"MsoNormal\" style=\"margin-left:2.0in;text-indent:-2.0in;mso-pagination:\nnone;background:#D9D9D9;mso-shading:windowtext;mso-pattern:gray-15 auto\"><b style=\"mso-bidi-font-weight:normal\"><span lang=\"EN-GB\" style=\"mso-bidi-font-size:\n12.0pt;color:black;mso-color-alt:windowtext\">Title: <span style=\"mso-tab-count:\n1\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <\/span><\/span><\/b><span style=\"mso-bidi-font-size:12.0pt;color:black;mso-color-alt:windowtext;\nmso-ansi-language:EN-US\">Sources of Difficulty in Language Processing and\nLearning<\/span><b style=\"mso-bidi-font-weight:normal\"><span lang=\"EN-GB\" style=\"mso-bidi-font-size:12.0pt\"><\/span><\/b><\/p>\n\n<p class=\"MsoNormal\" style=\"margin-left:2.0in;text-indent:-2.0in;mso-pagination:\nnone;background:#D9D9D9;mso-shading:windowtext;mso-pattern:gray-15 auto\"><b style=\"mso-bidi-font-weight:normal\"><span lang=\"EN-GB\" style=\"mso-bidi-font-size:\n12.0pt\">&nbsp;<\/span><\/b><\/p>\n\n<p class=\"MsoNormal\" style=\"margin-left:2.0in;text-indent:-2.0in;mso-pagination:\nnone;background:#D9D9D9;mso-shading:windowtext;mso-pattern:gray-15 auto\"><b style=\"mso-bidi-font-weight:normal\"><span lang=\"EN-GB\" style=\"mso-bidi-font-size:\n12.0pt;color:black;mso-color-alt:windowtext\">Principal Investigator:<span style=\"mso-tab-count:1\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <\/span><\/span><\/b><span lang=\"EN-GB\" style=\"mso-bidi-font-size:12.0pt;color:navy\">Tal Linzen (Department of\nLinguistics and the <span class=\"SpellE\">Center<\/span> for Data Science, New York\nUniversity)<\/span><b style=\"mso-bidi-font-weight:normal\"><span lang=\"EN-GB\" style=\"mso-bidi-font-size:12.0pt\"><\/span><\/b><\/p>\n\n<p class=\"MsoNormal\" style=\"margin-left:2.0in;text-indent:-2.0in;mso-pagination:\nnone;background:#D9D9D9;mso-shading:windowtext;mso-pattern:gray-15 auto\"><b style=\"mso-bidi-font-weight:normal\"><span lang=\"EN-GB\" style=\"mso-bidi-font-size:\n12.0pt\">&nbsp;<\/span><\/b><\/p>\n\n<p class=\"MsoNormal\" style=\"mso-pagination:none\"><b style=\"mso-bidi-font-weight:\nnormal\"><u><span style=\"mso-bidi-font-size:12.0pt;mso-ansi-language:EN-US\"><span style=\"text-decoration:none\">&nbsp;<\/span><\/span><\/u><\/b><\/p>\n\n<p class=\"MsoNormal\" style=\"margin-top:3.0pt;margin-right:0in;margin-bottom:6.0pt;\nmargin-left:0in;mso-pagination:none;page-break-after:avoid\"><b style=\"mso-bidi-font-weight:normal\"><u><span style=\"mso-bidi-font-size:12.0pt;\nmso-ansi-language:EN-US\">PURPOSE OF RESEARCH STUDY: <\/span><\/u><\/b><\/p>\n\n<p class=\"MsoNormal\" style=\"margin-bottom:6.0pt;mso-pagination:none\"><span style=\"mso-bidi-font-size:12.0pt;mso-ansi-language:EN-US\">The goal of the\nproject is to measure what makes particular aspects of language easier or harder\nto learn and understand.<\/span><\/p>\n\n<p class=\"MsoNormal\" style=\"margin-top:3.0pt;margin-right:0in;margin-bottom:6.0pt;\nmargin-left:0in;mso-pagination:none;page-break-after:avoid\"><b style=\"mso-bidi-font-weight:normal\"><u><span style=\"mso-bidi-font-size:12.0pt;\nmso-ansi-language:EN-US\">PROCEDURES:<\/span><\/u><\/b><\/p>\n\n<p class=\"MsoNormal\" style=\"margin-bottom:6.0pt;mso-pagination:none\"><span style=\"mso-bidi-font-size:12.0pt;mso-ansi-language:EN-US\">You will be asked to\nread or listen to language, and answer questions about what you\u2019ve read or\nheard. The sentences may be in English or in a made-up language that you will\nlearn during the experiment. The experiment involves a single session that will\ntake up to an hour; there will be up to five sessions, but most participants\nwill only participate in a single session.<\/span><\/p>\n\n<p class=\"MsoNormal\" style=\"margin-top:3.0pt;margin-right:0in;margin-bottom:6.0pt;\nmargin-left:0in;mso-pagination:none;page-break-after:avoid\"><b style=\"mso-bidi-font-weight:normal\"><u><span style=\"mso-bidi-font-size:12.0pt;\nmso-ansi-language:EN-US\">RISKS\/DISCOMFORTS:<\/span><\/u><\/b><\/p>\n\n<h4 style=\"margin-bottom:6.0pt;mso-pagination:none;page-break-after:auto\">The\nrisks associated with participation in this study are no greater than those\nencountered in daily life.<\/h4>\n\n<p class=\"MsoNormal\" style=\"margin-top:3.0pt;margin-right:0in;margin-bottom:6.0pt;\nmargin-left:0in;mso-pagination:none;page-break-after:avoid\"><b style=\"mso-bidi-font-weight:normal\"><u><span style=\"mso-bidi-font-size:12.0pt;\nmso-ansi-language:EN-US\">BENEFITS:<\/span><\/u><\/b><\/p>\n\n<p class=\"MsoNormal\" style=\"margin-bottom:6.0pt;mso-pagination:none\"><span lang=\"EN-GB\" style=\"mso-bidi-font-size:12.0pt\">There are no direct benefits to\nyou from participating in this study. <\/span><span lang=\"EN-GB\">This study may\nbenefit society if the results lead to a better understanding of what makes\ncertain aspects of language easier or harder to learn and understand.<\/span><\/p>\n\n<p class=\"MsoNormal\" style=\"margin-top:3.0pt;margin-right:0in;margin-bottom:6.0pt;\nmargin-left:0in;mso-pagination:none;page-break-after:avoid\"><b style=\"mso-bidi-font-weight:normal\"><u><span style=\"mso-bidi-font-size:12.0pt;\nmso-ansi-language:EN-US\">VOLUNTARY PARTICIPATION AND RIGHT TO WITHDRAW:<\/span><\/u><\/b><\/p>\n\n<p class=\"MsoNormal\" style=\"margin-bottom:6.0pt;mso-pagination:none\"><span lang=\"EN-GB\" style=\"mso-bidi-font-size:12.0pt\">Your<\/span><span style=\"mso-bidi-font-size:\n12.0pt;mso-ansi-language:EN-US\"> participation in this study is entirely\nvoluntary: You choose whether to participate. If you decide not to participate,\nthere are no penalties, and you will not lose any benefits to which you would\notherwise be entitled.<\/span><\/p>\n\n<p class=\"MsoNormal\" style=\"margin-bottom:6.0pt;mso-pagination:none\"><span style=\"mso-bidi-font-size:12.0pt;mso-ansi-language:EN-US\">If you choose to\nparticipate in the study, you can stop your participation at any time, without\nany penalty or loss of benefits.  <\/span><\/p>\n\n<h6 style=\"margin-top:3.0pt;margin-right:0in;margin-bottom:6.0pt;margin-left:\n0in;mso-pagination:none\">CONFIDENTIALITY:<\/h6>\n\n<p class=\"MsoNormal\" style=\"margin-bottom:6.0pt;mso-pagination:none\"><span lang=\"EN-GB\" style=\"mso-bidi-font-size:12.0pt\">Any study records that identify\nyou will be kept confidential to the extent possible by law. The records from\nyour participation may be reviewed by people responsible for making sure that\nresearch is done properly. Otherwise, records that identify you will be\navailable only to people working on the study, unless you give permission for\nother people to see the records.<\/span><\/p>\n\n<p class=\"MsoNormal\" style=\"margin-bottom:6.0pt;mso-pagination:none\"><span lang=\"EN-GB\" style=\"mso-bidi-font-size:12.0pt\">Any study records that include\nyour name will be kept in a password-protected database. On all records of test <span class=\"GramE\">results<\/span> we will use a code number rather than your name.<\/span><span lang=\"EN-GB\"> <\/span><\/p>\n\n<p class=\"MsoNormal\" style=\"margin-top:3.0pt;margin-right:0in;margin-bottom:6.0pt;\nmargin-left:0in;mso-pagination:none;page-break-after:avoid\"><b style=\"mso-bidi-font-weight:normal\"><u><span lang=\"EN-GB\" style=\"mso-bidi-font-size:\n12.0pt\">COMPENSATION:<\/span><\/u><\/b><\/p>\n\n<p class=\"MsoNormal\" style=\"margin-bottom:6.0pt;mso-pagination:none\"><span lang=\"EN-GB\" style=\"mso-bidi-font-size:12.0pt\">You will receive compensation <\/span><span lang=\"EN-GB\">in proportion to the length of the session.<\/span><\/p>\n\n<p class=\"MsoNormal\" style=\"margin-top:3.0pt;margin-right:0in;margin-bottom:6.0pt;\nmargin-left:0in;mso-pagination:none;page-break-after:avoid\"><b style=\"mso-bidi-font-weight:normal\"><u><span lang=\"EN-GB\" style=\"mso-bidi-font-size:\n12.0pt\">IF YOU HAVE QUESTIONS OR CONCERNS:<\/span><\/u><\/b><\/p>\n\n<p class=\"MsoNormal\" style=\"margin-bottom:6.0pt;mso-pagination:none\"><span lang=\"EN-GB\">You can ask questions about this research study now or at any time\nduring the study, by talking to the researcher(s) working with you or by emailing\n<span class=\"SpellE\">Dr.<\/span> Tal Linzen at linzen@nyu.edu. <\/span><\/p>\n\n<p class=\"MsoNormal\" style=\"margin-bottom:6.0pt;mso-pagination:none\"><span lang=\"EN-GB\" style=\"mso-bidi-font-size:12.0pt\">If you have questions about your\nrights as a research participant or feel that you have not been treated fairly,\nplease <\/span><span style=\"mso-bidi-font-size:12.0pt;mso-ansi-language:EN-US\">contact\nthe NYU Institutional Review Board at <a href=\"mailto:ask.humansubjects@nyu.edu\">ask.humansubjects@nyu.edu<\/a>\nor <b>212.998.4808.<\/b><\/span><\/p>\n<\/div>","DefaultChoices":false,"DataExportTag":"IRB","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Informed Consent Form IRB-FY2020-4512 Title: \u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 Sources of Dif...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID3"}},{"SurveyID":"SV_9RfCnFkO7qKjVky","Element":"SQ","PrimaryAttribute":"QID42","SecondaryAttribute":"Which of the following describes the two birds? This is an attention check question. Select only...","TertiaryAttribute":null,"Payload":{"QuestionText":"Which of the following describes the two birds? This is an attention check question. Select only the option that mentions two colors.","DataExportTag":"AT1","QuestionType":"MC","Selector":"MAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Which of the following describes the two birds? This is an attention check question. Select only...","Choices":{"1":{"Display":"Residency versus migration"},"2":{"Display":"Solitary defence versus gregarious flocking"},"3":{"Display":"Predator versus prey"},"4":{"Display":"Green versus black"},"5":{"Display":"None of the above"}},"ChoiceOrder":[1,2,3,4,"5"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":7,"NextAnswerId":1,"QuestionID":"QID42","Randomization":{"Advanced":{"FixedOrder":["{~Randomized~}","{~Randomized~}","{~Randomized~}","{~Randomized~}","5"],"RandomSubSet":[],"RandomizeAll":["1","2","3","4"],"ScaleReversal":[],"TotalRandSubset":0,"Undisplayed":[]},"ConsistentScaleReve
    {
      "SurveyID": "SV_0961YqCknhiSxNQ",
      "Element": "SQ",
      "PrimaryAttribute": "QID1721374460",
      "SecondaryAttribute": "Instructions Please complete this task in one sitting without writing anything down or using outs...",
      "TertiaryAttribute": null,
      "Payload": {
        "QuestionText": "<h2>Instructions</h2><p>Please complete this task in one sitting <strong>without writing anything down</strong> or using outside resources.<br>\n<br>\nYou will listen to four passages of text. Each passage will be between 1-4 minutes long. You will only be able to listen to each passage <strong>once</strong>. After listening to each passage, you will answer some questions about its contents.<br>\n<br>\nDo your best to answer accurately, but don't worry if you are unsure about any answers. Some passages and questions may be more difficult to answer than others.<br>\n<br>\nYou may take a short break between passages if needed, but please keep breaks brief and stay focused on the task.</p>",
        "DefaultChoices": false,
        "QuestionType": "DB",
        "Selector": "TB",
        "DataVisibility": {
          "Private": false,
          "Hidden": false
        },
        "Configuration": {
          "QuestionDescriptionOption": "UseText"
        },
        "QuestionDescription": "Instructions Please complete this task in one sitting without writing anything down or using outs...",
        "ChoiceOrder": [],
        "Validation": {
          "Settings": {
            "Type": "None"
          }
        },
        "GradingData": [],
        "Language": [],
        "NextChoiceId": 4,
        "NextAnswerId": 1,
        "QuestionText_Unsafe": "<h2>Instructions</h2>\n\n<p>Please complete this task in one sitting <strong>without writing anything down</strong> or using outside resources.</p>\n\n<p>&nbsp;</p>\n\n<p>You will listen to a passage of text describing multiple bird species. You will then answer some questions about the contents of the text. Do your best to answer accurately, but don&#39;t worry if you are unsure about any answers. Some questions may be more difficult to answer than others.</p>",
        "DataExportTag": "Q1",
        "QuestionID": "QID1721374460"
      }
    },

      "Element": "SQ",
      "Payload": {
        "QuestionText": "Which of the following correctly describes what drives Teodora Bianchi? Select all that apply.",
        "DataExportTag": "books_QB01",
        "QuestionType": "MC",
        "Selector": "MAVR",
        "SubSelector": "TX",
        "DataVisibility": {
          "Private": false,
          "Hidden": false
        },
        "Configuration": {
          "QuestionDescriptionOption": "UseText"
        },
        "QuestionDescription": "Which of the following correctly describes what drives Teodora Bianchi? Select all that apply.",
        "Choices": {
          "1": {
            "Display": "Publishing only what the poet herself would have wanted — protecting the legacy rather than satisfying what others want from it"
          },
          "2": {
            "Display": "Completing a translation he's spent three years on, which he believes is the poet's most significant work"
          },
          "3": {
            "Display": "Making sure researchers can access the manuscripts regardless of what gets commercially published"
          },
          "4": {
            "Display": "Demonstrating that protecting a literary reputation and satisfying a readership aren't in conflict"
          },
          "5": {
            "Display": "None of the above"
          }
        },
        "ChoiceOrder": [
          "1",
          "2",
          "3",
          "4",
          "5"

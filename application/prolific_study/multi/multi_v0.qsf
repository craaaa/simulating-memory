    {
      "SurveyID": "SV_e9gPkOgZMHdx5no",
      "Element": "SQ",
      "PrimaryAttribute": "QID16",
      "SecondaryAttribute": "Instructions Please complete this task in one sitting without writing anything down or using outs...",
      "TertiaryAttribute": null,
      "Payload": {
        "QuestionText": "<h2>Instructions</h2>\n\n<p>Please complete this task in one sitting <strong>without writing anything down</strong> or using outside resources.</p>\n\n<p>&nbsp;</p>\n\n<p>You will listen to a passage of text describing multiple bird species. You will then answer some questions about the contents of the text. Do your best to answer accurately, but don&#39;t worry if you are unsure about any answers. Some questions may be more difficult to answer than others.</p>",
        "DefaultChoices": false,
        "DataExportTag": "intro",
        "QuestionType": "DB",
        "Selector": "TB",
        "DataVisibility": {
          "Private": false,
          "Hidden": false
        },
        "Configuration": {
          "QuestionDescriptionOption": "UseText"
        },
        "QuestionDescription": "Instructions Please complete this task in one sitting without writing anything down or using outs...",
        "ChoiceOrder": [],

yload": {"ProjectCategory": "CORE", "SchemaVersion": "1.1.0"}}, {"SurveyID": "SV_eEdGRWgttz2LSUS", "Element": "QC", "PrimaryAttribute": "Survey Question Count", "SecondaryAttribute": "56", "TertiaryAttribute": null, "Payload": null}, {"SurveyID": "SV_eEdGRWgttz2LSUS", "Element": "RS", "PrimaryAttribute": "RS_ePcCDp35RNgnE4C", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": null}, {"SurveyID": "SV_eEdGRWgttz2LSUS", "Element": "SCO", "PrimaryAttribute": "Scoring", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"ScoringCategories": [], "ScoringCategoryGroups": [], "ScoringSummaryCategory": null, "ScoringSummaryAfterQuestions": 0, "ScoringSummaryAfterSurvey": 0, "DefaultScoringCategory": null, "AutoScoringCategory": null}}, {"SurveyID": "SV_eEdGRWgttz2LSUS", "Element": "SO", "PrimaryAttribute": "Survey Options", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"BackButton": "false", "SaveAndContinue": "false", "SurveyProtection": "PublicSurvey", "BallotBoxStuffingPrevention": "true", "NoIndex": "Yes", "SecureResponseFiles": "true", "SurveyExpiration": "None", "SurveyTermination": "DefaultMessage", "Header": "", "Footer": "", "ProgressBarDisplay": "None", "PartialData": "+2 hours", "ValidationMessage": null, "PreviousButton": "", "NextButton": "", "SurveyTitle": "Listening Comprehension Survey", "SkinLibrary": "nyu", "SkinType": "component", "Skin": {"brandingId": null, "templateId": "*simple", "overrides": null}, "NewScoring": 1, "SurveyMetaDescription": "Listen to passages and then answer questions.", "EOSMessage": null, "ShowExportTags": "false", "CollectGeoLocation": "false", "PasswordProtection": "No", "AnonymizeResponse": "Yes", "RefererCheck": "No", "BallotBoxStuffingPreventionBehavior": "DefaultMessage", "BallotBoxStuffingPreventionMessage": null, "BallotBoxStuffingPreventionMessageLibrary": null, "BallotBoxStuffingPreventionURL": null, "RecaptchaV3": "false", "ConfirmStart": false, "AutoConfirmStart": false, "RelevantID": "false", "RelevantIDLockoutPeriod": "+30 days", "UseCustomSurveyLinkCompletedMessage": null, "SurveyLinkCompletedMessage": null, "SurveyLinkCompletedMessageLibrary": null, "ResponseSummary": "No", "EOSMessageLibrary": null, "EOSRedirectURL": null, "EmailThankYou": "false", "ThankYouEmailMessageLibrary": null, "ThankYouEmailMessage": null, "ValidateMessage": "false", "ValidationMessageLibrary": null, "InactiveSurvey": "DefaultMessage", "PartialDeletion": null, "PartialDataCloseAfter": "SurveyStart", "InactiveMessageLibrary": null, "InactiveMessage": null, "AvailableLanguages": {"EN": []}, "SurveyAnalysisDisabled": true, "DetectDuplicateRespondents": true, "DetectDuplicateRespondentsDuration": "+30 days", "SurveyName": "multi_v6", "ProtectSelectionIds": true}}, {"SurveyID": "SV_eEdGRWgttz2LSUS", "Element": "SQ", "PrimaryAttribute": "QID1721374437", "SecondaryAttribute": "Informed Consent Form IRB-FY2020-4512 Title: \u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0", "TertiaryAttribute": null, "Payload": {"QuestionText": "<div class=\"WordSection1\"><p class=\"MsoNormal\" align=\"center\" style=\"text-align:center;background:#D9D9D9;\nmso-shading:windowtext;mso-pattern:gray-15 auto\"><b style=\"mso-bidi-font-weight:\nnormal\"><span lang=\"EN-GB\" style=\"font-size:14.0pt;mso-bidi-font-size:10.0pt;\ncolor:black;mso-color-alt:windowtext\">Informed Consent Form IRB-FY2020-4512</span></b><b style=\"mso-bidi-font-weight:normal\"><span lang=\"EN-GB\" style=\"font-size:14.0pt;\nmso-bidi-font-size:10.0pt\"></span></b></p>\n\n<p class=\"MsoNormal\" style=\"margin-left:2.0in;text-indent:-2.0in;mso-pagination:\nnone;background:#D9D9D9;mso-shading:windowtext;mso-pattern:gray-15 auto\"><b style=\"mso-bidi-font-weight:normal\"><span lang=\"EN-GB\" style=\"mso-bidi-font-size:\n12.0pt;color:black;mso-color-alt:windowtext\">Title: <span style=\"mso-tab-count:\n1\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; </span></span></b><span style=\"mso-bidi-font-size:12.0pt;color:black;mso-color-alt:windowtext;\nmso-ansi-language:EN-US\">Sources of Difficulty in Language Processing and\nLearning</span><b style=\"mso-bidi-font-weight:normal\"><span lang=\"EN-GB\" style=\"mso-bidi-font-size:12.0pt\"></span></b></p>\n\n<p class=\"MsoNormal\" style=\"margin-left:2.0in;text-indent:-2.0in;mso-pagination:\nnone;background:#D9D9D9;mso-shading:windowtext;mso-pattern:gray-15 auto\"><b style=\"mso-bidi-font-weight:normal\"><span lang=\"EN-GB\" style=\"mso-bidi-font-size:\n12.0pt\">&nbsp;</span></b></p>\n\n<p class=\"MsoNormal\" style=\"margin-left:2.0in;text-indent:-2.0in;mso-pagination:\nnone;background:#D9D9D9;mso-shading:windowtext;mso-pattern:gray-15 auto\"><b style=\"mso-bidi-font-weight:normal\"><span lang=\"EN-GB\" style=\"mso-bidi-font-size:\n12.0pt;color:black;mso-color-alt:windowtext\">Principal Investigator:<span style=\"mso-tab-count:1\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; </span></span></b><span lang=\"EN-GB\" style=\"mso-bidi-font-size:12.0pt;color:navy\">Tal Linzen (Department of\nLinguistics and the <span class=\"SpellE\">Center</span> for Data Science, New York\nUniversity)</span><b style=\"mso-bidi-font-weight:normal\"><span lang=\"EN-GB\" style=\"mso-bidi-font-size:12.0pt\"></span></b></p>\n\n<p class=\"MsoNormal\" style=\"margin-left:2.0in;text-indent:-2.0in;mso-pagination:\nnone;background:#D9D9D9;mso-shading:windowtext;mso-pattern:gray-15 auto\"><b style=\"mso-bidi-font-weight:normal\"><span lang=\"EN-GB\" style=\"mso-bidi-font-size:\n12.0pt\">&nbsp;</span></b></p>\n\n<p class=\"MsoNormal\" style=\"mso-pagination:none\"><b style=\"mso-bidi-font-weight:\nnormal\"><u><span style=\"mso-bidi-font-size:12.0pt;mso-ansi-language:EN-US\"><span style=\"text-decoration:none\">&nbsp;</span></span></u></b></p>\n\n<p class=\"MsoNormal\" style=\"margin-top:3.0pt;margin-right:0in;margin-bottom:6.0pt;\nmargin-left:0in;mso-pagination:none;page-break-after:avoid\"><b style=\"mso-bidi-font-weight:normal\"><u><span style=\"mso-bidi-font-size:12.0pt;\nmso-ansi-language:EN-US\">PURPOSE OF RESEARCH STUDY: </span></u></b></p>\n\n<p class=\"MsoNormal\" style=\"margin-bottom:6.0pt;mso-pagination:none\"><span style=\"mso-bidi-font-size:12.0pt;mso-ansi-language:EN-US\">The goal of the\nproject is to measure what makes particular aspects of language easier or harder\nto learn and understand.</span></p>\n\n<p class=\"MsoNormal\" style=\"margin-top:3.0pt;margin-right:0in;margin-bottom:6.0pt;\nmargin-left:0in;mso-pagination:none;page-break-after:avoid\"><b style=\"mso-bidi-font-weight:normal\"><u><span style=\"mso-bidi-font-size:12.0pt;\nmso-ansi-language:EN-US\">PROCEDURES:</span></u></b></p>\n\n<p class=\"MsoNormal\" style=\"margin-bottom:6.0pt;mso-pagination:none\"><span style=\"mso-bidi-font-size:12.0pt;mso-ansi-language:EN-US\">You will be asked to\nread or listen to language, and answer questions about what you\u2019ve read or\nheard. The sentences may be in English or in a made-up language that you will\nlearn during the experiment. The experiment involves a single session that will\ntake up to an hour; there will be up to five sessions, but most participants\nwill only participate in a single session.</span></p>\n\n<p class=\"MsoNormal\" style=\"margin-top:3.0pt;margin-right:0in;margin-bottom:6.0pt;\nmargin-left:0in;mso-pagination:none;page-break-after:avoid\"><b style=\"mso-bidi-font-weight:normal\"><u><span style=\"mso-bidi-font-size:12.0pt;\nmso-ansi-language:EN-US\">RISKS/DISCOMFORTS:</span></u></b></p>\n\n<h4 style=\"margin-bottom:6.0pt;mso-pagination:none;page-break-after:auto\">The\nrisks associated with participation in this study are no greater than those\nencountered in daily life.</h4>\n\n<p class=\"MsoNormal\" style=\"margin-top:3.0pt;margin-right:0in;margin-bottom:6.0pt;\nmargin-left:0in;mso-pagination:none;page-break-after:avoid\"><b style=\"mso-bidi-font-weight:normal\"><u><span style=\"mso-bidi-font-size:12.0pt;\nmso-ansi-language:EN-US\">BENEFITS:</span></u></b></p>\n\n<p class=\"MsoNormal\" style=\"margin-bottom:6.0pt;mso-pagination:none\"><span lang=\"EN-GB\" style=\"mso-bidi-font-size:12.0pt\">There are no direct benefits to\nyou from participating in this study. </span><span lang=\"EN-GB\">This study may\nbenefit society if the results lead to a better understanding of what makes\ncertain aspects of language easier or harder to learn and understand.</span></p>\n\n<p class=\"MsoNormal\" style=\"margin-top:3.0pt;margin-right:0in;margin-bottom:6.0pt;\nmargin-left:0in;mso-pagination:none;page-break-after:avoid\"><b style=\"mso-bidi-font-weight:normal\"><u><span style=\"mso-bidi-font-size:12.0pt;\nmso-ansi-language:EN-US\">VOLUNTARY PARTICIPATION AND RIGHT TO WITHDRAW:</span></u></b></p>\n\n<p class=\"MsoNormal\" style=\"margin-bottom:6.0pt;mso-pagination:none\"><span lang=\"EN-GB\" style=\"mso-bidi-font-size:12.0pt\">Your</span><span style=\"mso-bidi-font-size:\n12.0pt;mso-ansi-language:EN-US\"> participation in this study is entirely\nvoluntary: You choose whether to participate. If you decide not to participate,\nthere are no penalties, and you will not lose any benefits to which you would\notherwise be entitled.</span></p>\n\n<p class=\"MsoNormal\" style=\"margin-bottom:6.0pt;mso-pagination:none\"><span style=\"mso-bidi-font-size:12.0pt;mso-ansi-language:EN-US\">If you choose to\nparticipate in the study, you can stop your participation at any time, without\nany penalty or loss of benefits.  </span></p>\n\n<h6 style=\"margin-top:3.0pt;margin-right:0in;margin-bottom:6.0pt;margin-left:\n0in;mso-pagination:none\">CONFIDENTIALITY:</h6>\n\n<p class=\"MsoNormal\" style=\"margin-bottom:6.0pt;mso-pagination:none\"><span lang=\"EN-GB\" style=\"mso-bidi-font-size:12.0pt\">Any study records that identify\nyou will be kept confidential to the extent possible by law. The records from\nyour participation may be reviewed by people responsible for making sure that\nresearch is done properly. Otherwise, records that identify you will be\navailable only to people working on the study, unless you give permission for\nother people to see the records.</span></p>\n\n<p class=\"MsoNormal\" style=\"margin-bottom:6.0pt;mso-pagination:none\"><span lang=\"EN-GB\" style=\"mso-bidi-font-size:12.0pt\">Any study records that include\nyour name will be kept in a password-protected database. On all records of test <span class=\"GramE\">results</span> we will use a code number rather than your name.</span><span lang=\"EN-GB\"> </span></p>\n\n<p class=\"MsoNormal\" style=\"margin-top:3.0pt;margin-right:0in;margin-bottom:6.0pt;\nmargin-left:0in;mso-pagination:none;page-break-after:avoid\"><b style=\"mso-bidi-font-weight:normal\"><u><span lang=\"EN-GB\" style=\"mso-bidi-font-size:\n12.0pt\">COMPENSATION:</span></u></b></p>\n\n<p class=\"MsoNormal\" style=\"margin-bottom:6.0pt;mso-pagination:none\"><span lang=\"EN-GB\" style=\"mso-bidi-font-size:12.0pt\">You will receive compensation </span><span lang=\"EN-GB\">in proportion to the length of the session.</span></p>\n\n<p class=\"MsoNormal\" style=\"margin-top:3.0pt;margin-right:0in;margin-bottom:6.0pt;\nmargin-left:0in;mso-pagination:none;page-break-after:avoid\"><b style=\"mso-bidi-font-weight:normal\"><u><span lang=\"EN-GB\" style=\"mso-bidi-font-size:\n12.0pt\">IF YOU HAVE QUESTIONS OR CONCERNS:</span></u></b></p>\n\n<p class=\"MsoNormal\" style=\"margin-bottom:6.0pt;mso-pagination:none\"><span lang=\"EN-GB\">You can ask questions about this research study now or at any time\nduring the study, by talking to the researcher(s) working with you or by emailing\n<span class=\"SpellE\">Dr.</span> Tal Linzen at linzen@nyu.edu. </span></p>\n\n<p class=\"MsoNormal\" style=\"margin-bottom:6.0pt;mso-pagination:none\"><span lang=\"EN-GB\" style=\"mso-bidi-font-size:12.0pt\">If you have questions about your\nrights as a research participant or feel that you have not been treated fairly,\nplease </span><span style=\"mso-bidi-font-size:12.0pt;mso-ansi-language:EN-US\">contact\nthe NYU Institutional Review Board at <a href=\"mailto:ask.humansubjects@nyu.edu\">ask.humansubjects@nyu.edu</a>\nor <b>212.998.4808.</b></span></p>\n</div>", "DefaultChoices": false, "QuestionType": "DB", "Selector": "TB", "DataVisibility": {"Private": false, "Hidden": false}, "Configuration": {"QuestionDescriptionOption": "UseText"}, "QuestionDescription": "Informed Consent Form IRB-FY2020-4512 Title: \u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 Sources of Dif...", "ChoiceOrder": [], "Validation": {"Settings": {"Type": "None"}}, "GradingData": [], "Language": [], "NextChoiceId": 4, "NextAnswerId": 1, "QuestionText_Unsafe": "<div class=\"WordSection1\"><p class=\"MsoNormal\" align=\"center\" style=\"text-align:center;background:#D9D9D9;\nmso-shading:windowtext;mso-pattern:gray-15 auto\"><b style=\"mso-bidi-font-weight:\nnormal\"><span lang=\"EN-GB\" style=\"font-size:14.0pt;mso-bidi-font-size:10.0pt;\ncolor:black;mso-color-alt:windowtext\">Informed Consent Form IRB-FY2020-4512</span></b><b style=\"mso-bidi-font-weight:normal\"><span lang=\"EN-GB\" style=\"font-size:14.0pt;\nmso-bidi-font-size:10.0pt\"></span></b></p>\n\n<p class=\"MsoNormal\" style=\"margin-left:2.0in;text-indent:-2.0in;mso-pagination:\nnone;background:#D9D9D9;mso-shading:windowtext;mso-pattern:gray-15 auto\"><b style=\"mso-bidi-font-weight:normal\"><span lang=\"EN-GB\" style=\"mso-bidi-font-size:\n12.0pt;color:black;mso-color-alt:windowtext\">Title: <span style=\"mso-tab-count:\n1\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; </span></span></b><span style=\"mso-bidi-font-size:12.0pt;color:black;mso-color-alt:windowtext;\nmso-ansi-language:EN-US\">Sources of Difficulty in Language Processing and\nLearning</span><b style=\"mso-bidi-font-weight:normal\"><span lang=\"EN-GB\" style=\"mso-bidi-font-size:12.0pt\"></span></b></p>\n\n<p class=\"MsoNormal\" style=\"margin-left:2.0in;text-indent:-2.0in;mso-pagination:\nnone;background:#D9D9D9;mso-shading:windowtext;mso-pattern:gray-15 auto\"><b style=\"mso-bidi-font-weight:normal\"><span lang=\"EN-GB\" style=\"mso-bidi-font-size:\n12.0pt\">&nbsp;</span></b></p>\n\n<p class=\"MsoNormal\" style=\"margin-left:2.0in;text-indent:-2.0in;mso-pagination:\nnone;background:#D9D9D9;mso-shading:windowtext;mso-pattern:gray-15 auto\"><b style=\"mso-bidi-font-weight:normal\"><span lang=\"EN-GB\" style=\"mso-bidi-font-size:\n12.0pt;color:black;mso-color-alt:windowtext\">Principal Investigator:<span style=\"mso-tab-count:1\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; </span></span></b><span lang=\"EN-GB\" style=\"mso-bidi-font-size:12.0pt;color:navy\">Tal Linzen (Department of\nLinguistics and the <span class=\"SpellE\">Center</span> for Data Science, New York\nUniversity)</span><b style=\"mso-bidi-font-weight:normal\"><span lang=\"EN-GB\" style=\"mso-bidi-font-size:12.0pt\"></span></b></p>\n\n<p class=\"MsoNormal\" style=\"margin-left:2.0in;text-indent:-2.0in;mso-pagination:\nnone;background:#D9D9D9;mso-shading:windowtext;mso-pattern:gray-15 auto\"><b style=\"mso-bidi-font-weight:normal\"><span lang=\"EN-GB\" style=\"mso-bidi-font-size:\n12.0pt\">&nbsp;</span></b></p>\n\n<p class=\"MsoNormal\" style=\"mso-pagination:none\"><b style=\"mso-bidi-font-weight:\nnormal\"><u><span style=\"mso-bidi-font-size:12.0pt;mso-ansi-language:EN-US\"><span style=\"text-decoration:none\">&nbsp;</span></span></u></b></p>\n\n<p class=\"MsoNormal\" style=\"margin-top:3.0pt;margin-right:0in;margin-bottom:6.0pt;\nmargin-left:0in;mso-pagination:none;page-break-after:avoid\"><b style=\"mso-bidi-font-weight:normal\"><u><span style=\"mso-bidi-font-size:12.0pt;\nmso-ansi-language:EN-US\">PURPOSE OF RESEARCH STUDY: </span></u></b></p>\n\n<p class=\"MsoNormal\" style=\"margin-bottom:6.0pt;mso-pagination:none\"><span style=\"mso-bidi-font-size:12.0pt;mso-ansi-language:EN-US\">The goal of the\nproject is to measure what makes particular aspects of language easier or harder\nto learn and understand.</span></p>\n\n<p class=\"MsoNormal\" style=\"margin-top:3.0pt;margin-right:0in;margin-bottom:6.0pt;\nmargin-left:0in;mso-pagination:none;page-break-after:avoid\"><b style=\"mso-bidi-font-weight:normal\"><u><span style=\"mso-bidi-font-size:12.0pt;\nmso-ansi-language:EN-US\">PROCEDURES:</span></u></b></p>\n\n<p class=\"MsoNormal\" style=\"margin-bottom:6.0pt;mso-pagination:none\"><span style=\"mso-bidi-font-size:12.0pt;mso-ansi-language:EN-US\">You will be asked to\nread or listen to language, and answer questions about what you\u2019ve read or\nheard. The sentences may be in English or in a made-up language that you will\nlearn during the experiment. The experiment involves a single session that will\ntake up to an hour; there will be up to five sessions, but most participants\nwill only participate in a single session.</span></p>\n\n<p class=\"MsoNormal\" style=\"margin-top:3.0pt;margin-right:0in;margin-bottom:6.0pt;\nmargin-left:0in;mso-pagination:none;page-break-after:avoid\"><b style=\"mso-bidi-font-weight:normal\"><u><span style=\"mso-bidi-font-size:12.0pt;\nmso-ansi-language:EN-US\">RISKS/DISCOMFORTS:</span></u></b></p>\n\n<h4 style=\"margin-bottom:6.0pt;mso-pagination:none;page-break-after:auto\">The\nrisks associated with participation in this study are no greater than those\nencountered in daily life.</h4>\n\n<p class=\"MsoNormal\" style=\"margin-top:3.0pt;margin-right:0in;margin-bottom:6.0pt;\nmargin-left:0in;mso-pagination:none;page-break-after:avoid\"><b style=\"mso-bidi-font-weight:normal\"><u><span style=\"mso-bidi-font-size:12.0pt;\nmso-ansi-language:EN-US\">BENEFITS:</span></u></b></p>\n\n<p class=\"MsoNormal\" style=\"margin-bottom:6.0pt;mso-pagination:none\"><span lang=\"EN-GB\" style=\"mso-bidi-font-size:12.0pt\">There are no direct benefits to\nyou from participating in this study. </span><span lang=\"EN-GB\">This study may\nbenefit society if the results lead to a better understanding of what makes\ncertain aspects of language easier or harder to learn and understand.</span></p>\n\n<p class=\"MsoNormal\" style=\"margin-top:3.0pt;margin-right:0in;margin-bottom:6.0pt;\nmargin-left:0in;mso-pagination:none;page-break-after:avoid\"><b style=\"mso-bidi-font-weight:normal\"><u><span style=\"mso-bidi-font-size:12.0pt;\nmso-ansi-language:EN-US\">VOLUNTARY PARTICIPATION AND RIGHT TO WITHDRAW:</span></u></b></p>\n\n<p class=\"MsoNormal\" style=\"margin-bottom:6.0pt;mso-pagination:none\"><span lang=\"EN-GB\" style=\"mso-bidi-font-size:12.0pt\">Your</span><span style=\"mso-bidi-font-size:\n12.0pt;mso-ansi-language:EN-US\"> participation in this study is entirely\nvoluntary: You choose whether to participate. If you decide not to participate,\nthere are no penalties, and you will not lose any benefits to which you would\notherwise be entitled.</span></p>\n\n<p class=\"MsoNormal\" style=\"margin-bottom:6.0pt;mso-pagination:none\"><span style=\"mso-bidi-font-size:12.0pt;mso-ansi-language:EN-US\">If you choose to\nparticipate in the study, you can stop your participation at any time, without\nany penalty or loss of benefits.  </span></p>\n\n<h6 style=\"margin-top:3.0pt;margin-right:0in;margin-bottom:6.0pt;margin-left:\n0in;mso-pagination:none\">CONFIDENTIALITY:</h6>\n\n<p class=\"MsoNormal\" style=\"margin-bottom:6.0pt;mso-pagination:none\"><span lang=\"EN-GB\" style=\"mso-bidi-font-size:12.0pt\">Any study records that identify\nyou will be kept confidential to the extent possible by law. The records from\nyour participation may be reviewed by people responsible for making sure that\nresearch is done properly. Otherwise, records that identify you will be\navailable only to people working on the study, unless you give permission for\nother people to see the records.</span></p>\n\n<p class=\"MsoNormal\" style=\"margin-bottom:6.0pt;mso-pagination:none\"><span lang=\"EN-GB\" style=\"mso-bidi-font-size:12.0pt\">Any study records that include\nyour name will be kept in a password-protected database. On all records of test <span class=\"GramE\">results</span> we will use a code number rather than your name.</span><span lang=\"EN-GB\"> </span></p>\n\n<p class=\"MsoNormal\" style=\"margin-top:3.0pt;margin-right:0in;margin-bottom:6.0pt;\nmargin-left:0in;mso-pagination:none;page-break-after:avoid\"><b style=\"mso-bidi-font-weight:normal\"><u><span lang=\"EN-GB\" style=\"mso-bidi-font-size:\n12.0pt\">COMPENSATION:</span></u></b></p>\n\n<p class=\"MsoNormal\" style=\"margin-bottom:6.0pt;mso-pagination:none\"><span lang=\"EN-GB\" style=\"mso-bidi-font-size:12.0pt\">You will receive compensation </span><span lang=\"EN-GB\">in proportion to the length of the session.</span></p>\n\n<p class=\"MsoNormal\" style=\"margin-top:3.0pt;margin-right:0in;margin-bottom:6.0pt;\nmargin-left:0in;mso-pagination:none;page-break-after:avoid\"><b style=\"mso-bidi-font-weight:normal\"><u><span lang=\"EN-GB\" style=\"mso-bidi-font-size:\n12.0pt\">IF YOU HAVE QUESTIONS OR CONCERNS:</span></u></b></p>\n\n<p class=\"MsoNormal\" style=\"margin-bottom:6.0pt;mso-pagination:none\"><span lang=\"EN-GB\">You can ask questions about this research study now or at any time\nduring the study, by talking to the researcher(s) working with you or by emailing\n<span class=\"SpellE\">Dr.</span> Tal Linzen at linzen@nyu.edu. </span></p>\n\n<p class=\"MsoNormal\" style=\"margin-bottom:6.0pt;mso-pagination:none\"><span lang=\"EN-GB\" style=\"mso-bidi-font-size:12.0pt\">If you have questions about your\nrights as a research participant or feel that you have not been treated fairly,\nplease </span><span style=\"mso-bidi-font-size:12.0pt;mso-ansi-language:EN-US\">contact\nthe NYU Institutional Review Board at <a href=\"mailto:ask.humansubjects@nyu.edu\">ask.humansubjects@nyu.edu</a>\nor <b>212.998.4808.</b></span></p>\n</div>", "DataExportTag": "Q1", "QuestionID": "QID1721374437"}}, {"SurveyID": "SV_eEdGRWgttz2LSUS", "Element": "SQ", "PrimaryAttribute": "QID1721374438", "SecondaryAttribute": "Do you consent to participate in this study?", "TertiaryAttribute": null, "Payload": {"QuestionText": "Do you consent to participate in this study?", "DefaultChoices": false, "QuestionType": "MC", "Selector": "SAVR", "SubSelector": "TX", "DataVisibility": {"Private": false, "Hidden": false}, "Configuration": {"QuestionDescriptionOption": "UseText"}, "QuestionDescription": "Do you consent to participate in this study?", "Choices": {"1": {"Display": "I consent"}, "2": {"Display": "I do not consent"}}, "ChoiceOrder": [1, 2], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "GradingData": [], "Language": [], "NextChoiceId": 3, "NextAnswerId": 1, "QuestionText_Unsafe": "Do you consent to participate in this study?", "DataExportTag": "Q2", "QuestionID": "QID1721374438", "Randomization": {"Advanced": {"FixedOrder": ["{~Randomized~}", "2"], "RandomSubSet": [], "RandomizeAll": ["1"], "ScaleReversal": [], "TotalRandSubset": 0, "Undisplayed": []}, "ConsistentScaleReversal": false, "EvenPresentation": false, "TotalRandSubset": "", "Type": "Advanced"}}}, {"SurveyID": "SV_eEdGRWgttz2LSUS", "Element": "SQ", "PrimaryAttribute": "QID1721374457", "SecondaryAttribute": "Before beginning, let's ensure your audio is working! \u00a0 Make sure that you can hear the following..", "TertiaryAttribute": null, "Payload": {"QuestionText": "Before beginning, let's ensure your audio is working!<br>\n&nbsp;\n<p>Make sure that you can hear the following audio clip, then select the appropriate answer(s) below.</p>\n\n<div style=\"text-align: center;\">\n&nbsp;<audio class=\"qmedia\" controls=\"true\" height=\"40\" preload=\"auto\" width=\"320\"><source src=\"https://nyu.qualtrics.com/CP/File.php?F=F_6eZKbCROjRZ1IcC\" type=\"audio/mp3\"></audio>\n</div>", "DefaultChoices": false, "QuestionType": "MC", "Selector": "MAVR", "DataVisibility": {"Private": false, "Hidden": false}, "Configuration": {"QuestionDescriptionOption": "UseText", "NumColumns": 2, "LabelPosition": "BELOW"}, "QuestionDescription": "Before beginning, let's ensure your audio is working! \u00a0 Make sure that you can hear the following...", "Choices": {"4": {"Display": "412"}, "5": {"Display": "28"}, "6": {"Display": "-356"}, "7": {"Display": "7"}}, "ChoiceOrder": ["4", "5", "6", "7"], "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None", "MinChoices": "1"}}, "GradingData": [], "Language": [], "NextChoiceId": 8, "NextAnswerId": 1, "SubSelector": "TX", "QuestionText_Unsafe": "<p>Let's ensure your audio is working!</p><p><br></p><p>Make sure that you can hear the following audio clip, then select the appropriate answer(s) below.</p>\n\n<div style=\"text-align: center;\">\n<audio class=\"qmedia\" controls=\"true\" height=\"40\" preload=\"auto\" width=\"320\"><source src=\"https://nyu.qualtrics.com/CP/File.php?F=F_2hq7EqZGgsafYkS\" type=\"audio/wav\"></audio>\n</div>", "DataExportTag": "Q1", "QuestionID": "QID1721374457", "Randomization": {"Advanced": {"FixedOrder": ["{~Randomized~}", "{~Randomized~}", "{~Randomized~}", "7"], "RandomSubSet": [], "RandomizeAll": ["4", "5", "6"], "ScaleReversal": [], "TotalRandSubset": 0, "Undisplayed": []}, "ConsistentScaleReversal": false, "EvenPresentation": false, "TotalRandSubset": "", "Type": "Advanced"}}}, {"SurveyID": "SV_eEdGRWgttz2LSUS", "Element": "SQ", "PrimaryAttribute": "QID1721374458", "SecondaryAttribute": "Click 'Start' to begin the experiment.", "TertiaryAttribute": null, "Payload": {"QuestionText": "Click 'Start' to begin the experiment.", "DefaultChoices": false, "QuestionType": "DB", "Selector": "TB", "DataVisibility": {"Private": false, "Hidden": false}, "Configuration": {"QuestionDescriptionOption": "UseText"}, "QuestionDescription": "Click 'Start' to begin the experiment.", "ChoiceOrder": [], "Validation": {"Settings": {"Type": "None"}}, "GradingData": [], "Language": [], "NextChoiceId": 4, "NextAnswerId": 1, "QuestionText_Unsafe": "Click 'Start' to begin the experiment.", "DataExportTag": "Q2", "QuestionID": "QID1721374458"}}, {"SurveyID": "SV_eEdGRWgttz2LSUS", "Element": "SQ", "PrimaryAttribute": "QID1721374459", "SecondaryAttribute": "Thank you for participating! Your responses have been recorded. Please click the 'End Task' butto...", "TertiaryAttribute": null, "Payload": {"QuestionText": "Thank you for participating! Your responses have been recorded.<br>\n<br>\nPlease click the 'End Task' button below to return to Prolific and confirm your completion.<br>\n<br>\n<strong>Do not close this window or use the back button</strong> \u2014 your submission is only finalized once you are redirected to Prolific.", "DefaultChoices": false, "QuestionType": "DB", "Selector": "TB", "DataVisibility": {"Private": false, "Hidden": false}, "Configuration": {"QuestionDescriptionOption": "UseText"}, "QuestionDescription": "Thank you for participating! Your responses have been recorded. Please click the 'End Task' butto...", "ChoiceOrder": [], "Validation": {"Settings": {"Type": "None"}}, "GradingData": [], "Language": [], "NextChoiceId": 4, "NextAnswerId": 1, "QuestionText_Unsafe": "Thank you for participating! Your responses have been recorded.<br>\n<br>\nPlease click the 'End Task' button below to return to Prolific and confirm your completion.<br>\n<br>\n<strong>Do not close this window or use the back button</strong> \u2014 your submission is only finalized once you are redirected to Prolific.", "DataExportTag": "Q1", "QuestionID": "QID1721374459"}}, {"SurveyID": "SV_eEdGRWgttz2LSUS", "Element": "SQ", "PrimaryAttribute": "QID1721374460", "SecondaryAttribute": "Instructions Please complete this task in one sitting without writing anything down or using outs...", "TertiaryAttribute": null, "Payload": {"QuestionText": "<h2>Instructions</h2><p>Please complete this task in one sitting <strong>without writing anything down</strong> or using outside resources.<br>\n<br>\nYou will listen to four passages of text. Each passage will be between 1-2 minutes long. You will only be able to listen to each passage <strong>once</strong>. After listening to each passage, you will answer some questions about its contents.<br>\n<br>\nDo your best to answer accurately, but don't worry if you are unsure about any answers. Some passages and questions may be more difficult than others.<br>\n<br>\nYou may take a short break between passages if needed, but please keep breaks brief and stay focused on the task.</p>", "DefaultChoices": false, "QuestionType": "DB", "Selector": "TB", "DataVisibility": {"Private": false, "Hidden": false}, "Configuration": {"QuestionDescriptionOption": "UseText"}, "QuestionDescription": "Instructions Please complete this task in one sitting without writing anything down or using outs...", "ChoiceOrder": [], "Validation": {"Settings": {"Type": "None"}}, "GradingData": [], "Language": [], "NextChoiceId": 4, "NextAnswerId": 1, "QuestionText_Unsafe": "<h2>Instructions</h2>\n\n<p>Please complete this task in one sitting <strong>without writing anything down</strong> or using outside resources.</p>\n\n<p>&nbsp;</p>\n\n<p>You will listen to a passage of text describing multiple bird species. You will then answer some questions about the contents of the text. Do your best to answer accurately, but don&#39;t worry if you are unsure about any answers. Some questions may be more difficult to answer than others.</p>", "DataExportTag": "Q1", "QuestionID": "QID1721374460"}}, {"SurveyID": "SV_eEdGRWgttz2LSUS", "Element": "SQ", "PrimaryAttribute": "QID2201", "SecondaryAttribute": "Timing", "TertiaryAttribute": null, "Payload": {"QuestionText": "Timing", "DefaultChoices": false, "DataExportTag": "astronomy_timing_passage", "QuestionID": "QID2201", "QuestionType": "Timing", "Selector": "PageTimer", "DataVisibility": {"Private": false, "Hidden": false}, "Configuration": {"QuestionDescriptionOption": "UseText", "MinSeconds": "0", "MaxSeconds": "0"}, "QuestionDescription": "Timing", "Choices": {"1": {"Display": "First Click"}, "2": {"Display": "Last Click"}, "3": {"Display": "Page Submit"}, "4": {"Display": "Click Count"}}, "GradingData": [], "Language": [], "NextChoiceId": 20, "NextAnswerId": 1}}, {"SurveyID": "SV_eEdGRWgttz2LSUS", "Element": "SQ", "PrimaryAttribute": "QID2202", "SecondaryAttribute": "Loading...", "TertiaryAttribute": null, "Payload": {"QuestionText": "Loading...", "DefaultChoices": false, "DataExportTag": "astronomy_trial", "QuestionType": "DB", "Selector": "TB", "DataVisibility": {"Private": false, "Hidden": false}, "Configuration": {"QuestionDescriptionOption": "UseText"}, "QuestionDescription": "Loading...", "ChoiceOrder": [], "Validation": {"Settings": {"Type": "None"}}, "GradingData": [], "Language": [], "NextChoiceId": 4, "NextAnswerId": 1, "QuestionID": "QID2202", "QuestionJS": "Qualtrics.SurveyEngine.addOnload(function () {\n    var qthis = this;\n    var _guardKey = '_audioLoaded_' + this.questionId;\n    if (window[_guardKey]) return;\n    window[_guardKey] = true;\n\n    var STIMULI = {\n        \"control\":      { \"url\": \"https://craaaa.github.io/simulating-memory/multi_v5/astronomy/audio/control.mp3\" },\n        \"repeat_short\":      { \"url\": \"https://craaaa.github.io/simulating-memory/multi_v5/astronomy/audio/repeat_short.mp3\" },\n        \"repeat_long\":      { \"url\": \"https://craaaa.github.io/simulating-memory/multi_v5/astronomy/audio/repeat_long.mp3\" },\n        \"distractor\":      { \"url\": \"https://craaaa.github.io/simulating-memory/multi_v5/astronomy/audio/distractor.mp3\" },\n    };\n    var docId = \"${e://Field/astronomy_cond}\";\n    var doc = STIMULI[docId];\n\n    if (!doc || !doc.url) {\n\t\tqthis.hideNextButton();\n        qthis.getQuestionContainer().innerHTML =\n            \"<p>Configuration error: missing audio for condition=\" + docId +\n            \". Please return this study on Prolific.</p>\";\n        return;\n    }\n\n    qthis.hideNextButton();\n\n    var container = qthis.getQuestionContainer();\n    container.innerHTML =\n        '<div id=\"audio-status\" style=\"text-align:center;font-weight:bold;margin-bottom:12px;\">Loading audio\u2026</div>' +\n        '<div id=\"audio-start-wrap\" style=\"text-align:center;margin-bottom:12px;\"></div>' +\n        '<div id=\"audio-progress\" style=\"text-align:center;color:#666;margin-bottom:12px;\"></div>';\n\n    var statusEl   = document.getElementById(\"audio-status\");\n    var startWrap  = document.getElementById(\"audio-start-wrap\");\n    var progressEl = document.getElementById(\"audio-progress\");\n\n    var audio = new Audio(doc.url);\n    audio.preload = \"auto\";\n    audio.loop    = false;\n\n    audio.addEventListener(\"contextmenu\", function (e) { e.preventDefault(); });\n\n    var progressIv = null;\n\n    function beginPlayback() {\n        startWrap.innerHTML = \"\";\n        statusEl.textContent = \"Audio is playing. Please listen carefully.\";\n\n        progressIv = setInterval(function () {\n            if (!isNaN(audio.duration) && audio.duration > 0) {\n                var remaining = Math.ceil(audio.duration - audio.currentTime);\n                progressEl.textContent = remaining > 0 ? remaining + \"s remaining\" : \"\";\n            }\n        }, 1000);\n\n        audio.play();\n    }\n\n    audio.addEventListener(\"canplaythrough\", function () {\n        statusEl.textContent = \"This passage is about an astronomical object. When you are ready, click to start listening.\";\n        startWrap.innerHTML =\n            '<button id=\"audio-start-btn\" style=\"font-size:1em;padding:8px 24px;\">\u25b6 Start Audio</button>';\n        document.getElementById(\"audio-start-btn\").addEventListener(\"click\", function () {\n            document.getElementById(\"audio-start-btn\").disabled = true;\n            beginPlayback();\n        });\n    }, { once: true });\n\n    audio.addEventListener(\"ended\", function () {\n        if (progressIv) { clearInterval(progressIv); }\n        statusEl.textContent  = \"Audio completed. Click Next to continue.\";\n        progressEl.textContent = \"\";\n        qthis.showNextButton();\n    });\n\n    audio.addEventListener(\"error\", function () {\n        if (progressIv) { clearInterval(progressIv); }\n        statusEl.textContent =\n            \"Audio failed to load. Please return this study on Prolific.\";\n    });\n});\n\nQualtrics.SurveyEngine.addOnUnload(function () {\n    // No-op; cleanup handled in ended/error handlers above.\n});"}}, {"SurveyID": "SV_eEdGRWgttz2LSUS", "Element": "SQ", "PrimaryAttribute": "QID2250", "SecondaryAttribute": "How difficult did you find the passage and the recall task?", "TertiaryAttribute": null, "Payload": {"QuestionText": "How difficult did you find the passage and the recall task?", "DefaultChoices": false, "DataExportTag": "astronomy_difficulty", "QuestionID": "QID2250", "QuestionType": "Slider", "Selector": "HSLIDER", "DataVisibility": {"Private": false, "Hidden": false}, "Configuration": {"QuestionDescriptionOption": "UseText", "TextPosition": "above", "CSSliderMin": 0, "CSSliderMax": 10, "GridLines": 10, "NumDecimals": "0", "ShowValue": true, "StarCount": 5, "StarType": "discrete", "SnapToGrid": false, "CustomStart": false, "NotApplicable": false, "MobileFirst": true}, "QuestionDescription": "How difficult did you find the passage and the recall task?", "Choices": {"1": {"Display": "Passage"}, "2": {"Display": "Recall task"}}, "ChoiceOrder": [1, 2], "Validation": {"Set
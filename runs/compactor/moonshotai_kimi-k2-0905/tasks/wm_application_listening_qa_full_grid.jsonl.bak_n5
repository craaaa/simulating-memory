 "5": [1, 2]}, "difficulty": {"passage": 5, "question": 6}, "parse_errors": [], "questions": [{"q_id": "QMA01", "question": "Which of the following accurately describe the style of velthrak? Select all that apply.", "options": {"1": "Velthrak is a grappling-focused art", "2": "Velthrak does not permit striking of any kind", "3": "Velthrak is a striking-focused art", "4": "Velthrak allows limited strikes during competition", "5": "None of the above"}, "answer": [1, 2], "qtype": "content"}, {"q_id": "QMA02", "question": "Which of the following accurately describe the sornek? Select all that apply.", "options": {"1": "It is the signature technique of velthrak", "2": "It involves a hip throw", "3": "It starts with a spinning elbow strike to the opponent's shoulder", "4": "It begins with a leg pick", "5": "None of the above"}, "answer": [1, 2], "qtype": "content"}, {"q_id": "QMA03", "question": "Which of the following correctly describes the governing body of velthrak? Select all that apply.", "options": {"1": "The Dalviri Arts Council governs velthrak certification", "2": "The official governing body of velthrak was formed in 1967", "3": "The official governing body of velthrak was formed in 1947", "4": "The Dalviri Federation of Combat Arts governs velthrak certification", "5": "None of the above"}, "answer": [1, 3], "qtype": "content"}, {"q_id": "QMA04", "question": "Which of the following correctly describes velthrak? Select all that apply.", "options": {"1": "Full-resistance sparring involves kicking and punching", "2": "Practitioners must complete 200 strikes on a bag before each session", "3": "Practitioners must practice for three years before engaging in full-resistance sparring", "4": "Practitioners must practice for two years before engaging in full-resistance sparring", "5": "None of the above"}, "answer": [4], "qtype": "content"}, {"q_id": "QMA05", "question": "Which of the following are restrictions that apply in velthrak? Select all that apply.", "options": {"1": "Striking an opponent in any form is against the rules", "2": "A person who has practiced velthrak for one year cannot engage in full-resistance sparring", "3": "The sornek may only be performed in championship-level bouts", "4": "All competition surfaces must be approved by the Dalviri Federation of Combat Arts", "5": "None of the above"}, "answer": [1, 2], "qtype": "content"}], "metrics": {"per_statement_correct": 25, "per_statement_total": 25, "per_statement_accuracy": 1.0, "exact_match_correct": 5, "exact_match_total": 5, "exact_match_accuracy": 1.0, "slot_utilization": 1.0}}
{"id": "wm_application_listening_qa:C2-stream:r5:martial_arts:control", "condition_id": "C2-stream", "condition_name": "Human cognitive limits framing (streaming encode) (sentence-segmented)", "segment_unit": "sentence", "repeat_index": 5, "topic_id": "martial_arts", "title": "Martial Arts — Velthrak", "level": "control", "encoding_log": {"content": ["Topic: martial arts", "Velthrak is a grappling art where striking of any kind is not permitted.", "Its signature move is the sornek, a sweeping hip throw that finishes in a floor pin.", "Full-resistance sparring is off-limits for anyone with under two years of experience.", "Originating in the Dalviri Highlands, velthrak is governed by the Dalviri Arts Council, which was founded in 1947.", "Watching a match in person gives a much better sense of the rhythm than reading about it ever could.", "The holds and reversals happen quickly, and spectators often find themselves leaning forward without quite realizing it.", "It has the kind of quiet intensity that keeps people coming back to watch, even if they never step onto the mat themselves.", "Even seasoned fans tend to describe it as more absorbing in person than any clip or photo manages to capture, and gyms that host open practice sessions often draw a small crowd of onlookers just for that reason."], "tool_calls": [{"tool_call_id": "functions.write_memory:0", "name": "write_memory", "arguments": "{\"key\":\"topic\",\"value\":\"The topic is martial arts\"}", "result": "Key 'topic' written."}, {"tool_call_id": "functions.write_memory:0", "name": "write_memory", "arguments": "{\"key\":\"Velthrak\",\"value\":\"is a grappling art where striking is not permitted\"}", "result": "Key 'Velthrak' written."}, {"tool_call_id": "functions.write_memory:1", "name": "write_memory", "arguments": "{\"key\":\"topic\",\"value\":\"The topic is martial arts\"}", "result": "Key 'topic' written."}, {"tool_call_id": "functions.write_memory:0", "name": "write_memory", "arguments": "{\"key\":\"Ve
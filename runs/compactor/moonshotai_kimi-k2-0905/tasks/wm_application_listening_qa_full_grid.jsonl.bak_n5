"tool_calls": [{"tool_call_id": "functions.write_memory:0", "name": "write_memory", "arguments": "{\"key\":\"Fornax Loop\",\"value\":\"A shell of gas puffed off by an aging star near the end of its life, roughly nine thousand light-years out, fainter and colder than younger nebulae, shows up best in infrared surveys\"}", "result": "Key 'Fornax Loop' written."}], "kv_snapshot": {"emission nebula": "A cloud of gas that glows because young stars inside it pour radiation into the surrounding gas", "observation method": "Astronomers observe the Pictor Nebula using an optical telescope tuned to red light", "distance": "The Pictor Nebula is located about four thousand light-years from Earth", "Fornax Loop": "A shell of gas puffed off by an aging star near the end of its life, roughly nine thousand light-years out, fainter and colder than younger nebulae, shows up best in infrared surveys"}}, {"segment_index": 8, "segment_text": "Researchers study the Loop mainly to trace how dying stars enrich space with the heavier elements they've built up over their lifetimes.", "tool_calls": [{"tool_call_id": "functions.write_memory:0", "name": "write_memory", "arguments": "{\"key\":\"Fornax Loop\",\"value\":\"A shell of gas puffed off by an aging star near the end of its life, roughly nine thousand light-years out, fainter and colder than younger nebulae, shows up best in infrared surveys, studied to trace how dying stars enrich space with heavier elements\"}", "result": "Key 'Fornax Loop' written."}], "kv_snapshot": {"emission nebula": "A cloud of gas that glows because young stars inside it pour radiation into the surrounding gas", "observation method": "Astronomers observe the Pictor Nebula using an optical telescope tuned to red light", "distance": "The Pictor Nebula is located about four thousand light-years from Earth", "Fornax Loop": "A shell of gas puffed off by an aging star near the end of its life, roughly nine thousand light-years out, fainter and colder than younger nebul
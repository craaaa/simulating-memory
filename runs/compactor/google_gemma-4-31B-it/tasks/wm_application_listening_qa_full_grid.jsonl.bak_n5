{"id": "wm_application_listening_qa:C2-stream:r1:martial_arts:control", "condition_id": "C2-stream", "condition_name": "Human cognitive limits framing (streaming encode) (sentence-segmented)", "segment_unit": "sentence", "repeat_index": 1, "topic_id": "martial_arts", "title": "Martial Arts — Velthrak", "level": "control", "encoding_log": {"content": ["Topic: martial arts", "Velthrak is a grappling art where striking of any kind is not permitted.", "Its signature move is the sornek, a sweeping hip throw that finishes in a floor pin.", "Full-resistance sparring is off-limits for anyone with under two years of experience.", "Originating in the Dalviri Highlands, velthrak is governed by the Dalviri Arts Council, which was founded in 1947.", "Watching a match in person gives a much better sense of the rhythm than reading about it ever could.", "The holds and reversals happen quickly, and spectators often find themselves leaning forward without quite realizing it.", "It has the kind of quiet intensity that keeps people coming back to watch, even if they never step onto the mat themselves.", "Even seasoned fans tend to describe it as more absorbing in person than any clip or photo manages to capture, and gyms that host open practice sessions often draw a small crowd of onlookers just for that reason."], "tool_calls": [{"tool_call_id": "chatcmpl-tool-aa851b425354a686", "name": "write_memory", "arguments": "{\"key\": \"topic\", \"value\": \"martial arts\"}", "result": "Key 'topic' written."}, {"tool_call_id": "chatcmpl-tool-a9fb26fe5dab3667", "name": "write_memory", "arguments": "{\"key\": \"Velthrak\", \"value\": \"grappling art where striking is not permitted\"}", "result": "Key 'Velthrak' written."}, {"tool_call_id": "chatcmpl-tool-b138ac5128f4a4e4", "name": "write_memory", "arguments": "{\"key\": \"sornek\", \"value\": \"sweeping hip throw finishing in a floor pin\"}", "result": "Key 'sornek' written."}, {"tool_call_id": "chatcmpl-tool-816fda6e802f81a2", "name": "write_m
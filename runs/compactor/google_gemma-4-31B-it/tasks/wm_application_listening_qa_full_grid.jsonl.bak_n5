lthrak": "grappling art; no punching, kicking, or elbowing permitted", "Velthrak_win": "win by throwing opponent and pinning them", "origin": "Originates in the Dalviri Highlands", "governance": "Governed by Dalviri Arts Council, founded 1947"}}, {"segment_index": 10, "segment_text": "Since its 1947 founding, the Dalviri Arts Council has set grades, licensed instructors, and overseen all sanctioned competition worldwide.", "tool_calls": [{"tool_call_id": "chatcmpl-tool-826935429c86098a", "name": "write_memory", "arguments": "{\"key\": \"governance\", \"value\": \"Dalviri Arts Council (est. 1947) sets grades, licenses instructors, and oversees competitions.\"}", "result": "Key 'governance' written."}], "kv_snapshot": {"Velthrak": "grappling art; no punching, kicking, or elbowing permitted", "Velthrak_win": "win by throwing opponent and pinning them", "origin": "Originates in the Dalviri Highlands", "governance": "Dalviri Arts Council (est. 1947) sets grades, licenses instructors, and oversees competitions."}}]}, "final_kv": {"Velthrak": "grappling art; no punching, kicking, or elbowing permitted", "Velthrak_win": "win by throwing opponent and pinning them", "origin": "Originates in the Dalviri Highlands", "governance": "Dalviri Arts Council (est. 1947) sets grades, licenses instructors, and oversees competitions."}, "recall_raw": "Question 1: 1,2\nQuestion 2: 5\nQuestion 3: 1,3\nQuestion 4: 5\nQuestion 5: 1\nPassage Difficulty: 3\nQuestion Difficulty: 4", "parsed_answers": {"1": [1, 2], "2": [5], "3": [1, 3], "4": [5], "5": [1]}, "difficulty": {"passage": 3, "question": 4}, "parse_errors": [], "questions": [{"q_id": "QMA01", "question": "Which of the following accurately describe the style of velthrak? Select all that apply.", "options": {"1": "Velthrak is a grappling-focused art", "2": "Velthrak does not permit striking of any kind", "3": "Velthrak is a striking-focused art", "4": "Velthrak allows limited strikes during competition", "5": "None of the above"}, "answer": [1, 2], "qtype": "content"}, {"q_id": "QMA02", "question": "Which of the following accurately describe the sornek? Select all that apply.", "options": {"1": "It is the signature technique of velthrak", "2": "It involves a hip throw", "3": "It starts with a spinning elbow strike to the opponent's shoulder", "4": "It begins with a leg pick", "5": "None of the above"}, "answer": [1, 2], "qtype": "content"}, {"q_id": "QMA03", "question": "Which of the following correctly describes the governing body of velthrak? Select all that apply.", "options": {"1": "The Dalviri Arts Council governs velthrak certification", "2": "The official governing body of velthrak was formed in 1967", "3": "The official governing body of velthrak was formed in 1947", "4": "The Dalviri Federation of Combat Arts governs velthrak certification", "5": "None of the above"}, "answer": [1, 3], "qtype": "content"}, {"q_id": "QMA04", "question": "Which of the following correctly describes velthrak? Select all that apply.", "options": {"1": "Full-resistance sparring involves kicking and punching", "2": "Practitioners must complete 200 strikes on a bag before each session", "3": "Practitioners must practice for three years before engaging in full-resistance sparring", "4": "Practitioners must practice for two years before engaging in full-resistance sparring", "5": "None of the above"}, "answer": [4], "qtype": "content"}, {"q_id": "QMA05", "question": "Which of the following are restrictions that apply in velthrak? Select all that apply.", "options": {"1": "Striking an opponent in any form is against the rules", "2": "A person who has practiced velthrak for one year cannot engage in full-resistance sparring", "3": "The sornek may only be performed in championship-level bouts", "4": "All competition surfaces must be approved by the Dalviri Federation of Combat Arts", "5": "None of the above"}, "answer": [1, 2], "qtype": "content"}], "metrics": {"per_statement_correct": 19, "per_statement_total": 25, "
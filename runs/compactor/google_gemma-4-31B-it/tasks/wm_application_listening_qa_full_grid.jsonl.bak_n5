sage Difficulty: 3\nQuestion Difficulty: 2", "parsed_answers": {"1": [1, 2], "2": [1, 2], "3": [1], "4": [5], "5": [1, 3]}, "difficulty": {"passage": 3, "question": 2}, "parse_errors": [], "questions": [{"q_id": "QFB01", "question": "Which of the following are true of Bracklin? Select all that apply.", "options": {"1": "It is made out of sheep's wool", "2": "It can be made out of the wool of Grennock mountain sheep", "3": "It can be made out of the wool of any type of sheep", "4": "It can be made out of the wool of Cheshire mountain sheep", "5": "None of the above"}, "answer": [1, 2], "qtype": "content"}, {"q_id": "QFB02", "question": "Which of the following are true of how Bracklin is woven? Select all that apply.", "options": {"1": "Two threads lock around each other during weaving", "2": "The interlocking binds two layers of cloth together without any stitching", "3": "Three threads are braided together tightly", "4": "The layers are bound together afterward with hand-stitching", "5": "None of the above"}, "answer": [1, 2], "qtype": "content"}, {"q_id": "QFB03", "question": "How is bracklin made? Select all that apply.", "options": {"1": "Double-weft interlock weaving", "2": "Double-warp chain weaving", "3": "Cross-thread basket weaving", "4": "Single-strand satin weaving", "5": "None of the above"}, "answer": [1], "qtype": "content"}, {"q_id": "QFB04", "question": "Which of the following correctly describes Bracklin?", "options": {"1": "An animal-based fiber used for winter carpets and ceremonial wall tapestries", "2": "An animal-based fiber used for summer garments and ceremonial robes", "3": "A plant-based fiber used for winter carpets and ceremonial wall tapestries", "4": "A plant-based fiber used for summer garments and ceremonial robes", "5": "None of the above"}, "answer": [5], "qtype": "content"}, {"q_id": "QFB05", "question": "Which of the following correctly describes a feature of bracklin? Select all that apply.", "options": {"1": "It comes in shades ranging from warm ivory to ash grey", "2": "It comes in shades ranging from pale green to straw yellow", "3": "It is produced mainly for winter outerwear and ceremonial robes", "4": "It is produced mainly for summer clothing and decorative hangings", "5": "None of the above"}, "answer": [1, 3], "qtype": "content"}], "metrics": {"per_statement_correct": 25, "per_statement_total": 25, "per_statement_accuracy": 1.0, "exact_match_correct": 5, "exact_match_total": 5, "exact_match_accuracy": 1.0, "slot_utilization": 1.0}}
{"id": "wm_application_listening_qa:C2-stream:r1:fabrics:distractor", "condition_id": "C2-stream", "condition_name": "Human cognitive limits framing (streaming encode) (sentence-segmented)", "segment_unit": "sentence", "repeat_index": 1, "topic_id": "fabrics", "title": "Fabrics — Bracklin", "level": "distractor", "encoding_log": {"content": ["Topic: fabrics", "Bracklin is a textile made exclusively from the fleece of the Grennock mountain sheep.", "Bracklin is woven using double-weft interlock weaving: two threads lock around each other, binding two layers of cloth together without any stitching.", "The cloth is used mainly for winter outerwear and ceremonial robes.", "Before it is dyed, bracklin fabric ranges from warm ivory to ash grey.", "It takes deep, even color with acid dyes but resists discharge printing.", "A related textile made in a nearby coastal region is Vessamere, spun from the silk-like filament produced by the harbor moth.", "Weavers there use a simple crossed-thread technique, passing the weft over and under a single warp line rather than locking multiple threads together.", "Vessamere is used mainly for lightweight scarves and drapery rather than heavy garments, since the filament stays thin no matter how tightly it is spun.", "Its natural, undyed tone sits somewhere between soft copper and deep rust, a warmth that comes entirely from the moth's own cocoon pigment, and most weavers leave that color untouched rather than dyeing over it."], "tool_calls": [{"tool_call_id": "chatcmpl-tool-a15356a67eeffdc2", "name": "write_memory", "arguments": "{\"key\": \"topic\", \"value\": \"The topic is fabrics.\"}", "result": "Key 'topic' written."}, {"tool_call_id": "chatcmpl-tool-a8b5cae3c9414eab", "name": "write_memory", "arguments": "{\"key\": \"Bracklin\", \"value\": \"A textile made from Grennock mountain sheep fleece.\"}", "result": "Key 'Bracklin' written."}, {"tool_call_id": "chatcmpl-tool-9f5d5713fece9fa3", "name": "write_memory", "arguments": "{\"key\": \"Bracklin\", \"value\": \"Textile from Grennock mountain sheep fleece, woven using double-weft interlock weaving.\"}", "result": "Key 'Bracklin' written."}, {"tool_call_id": "chatcmpl-tool-8d975027df1038ee", "name": "write_memory", "arguments": "{\"key\": \"weaving_method\", \"value\": \"Double-weft interlock binds two cloth layers without stitching.\"}", "result": "Key 'weaving_method' written."}, {"tool_call_id": "chatcmpl-tool-9d7c083ba36e37cf", "name": "write_memory", "arguments": "{\"key\": \"usage\", \"value\": \"Used for winter outerwear and ceremonial robes.\"}", "result": "Key 'usage' written."}, {"tool_call_id": "chatcmpl-tool-b112f183b8072224", "name": "write_memory", "arguments": "{\"key\": \"Bracklin\", \"value\": \"Textile from Grennock sheep fleece, double-weft interlock, ranges ivory to ash grey.\"}", "result": "Key 'Bracklin' written."}, {"tool_call_id": "chatcmpl-tool-9f7f9fcfe2575d56", "name": "write_memory", "arguments": "{\"key\": \"dyeing\", \"value\": \"Takes deep color with acid dyes but resists discharge printing.\"}", "result": "Error: memory is full (4 keys). Delete an existing key first or overwrite one."}, {"tool_call_id": "chatcmpl-tool-b4f9a80f6a8bac62", "name": "delete_key", "arguments": "{\"key\": \"weaving_method\"}", "result": "Key 'weaving_method' deleted."}, {"tool_call_id": "chatcmpl-tool-b4f69ae2c3540041", "name": "write_memory", "arguments": "{\"key\": \"dyeing\", \"value\": \"Takes deep color with acid dyes but resists discharge printing.\"}", "result": "Key 'dyeing' written."}, {"tool_call_id": "chatcmpl-tool-adf65a62fd5147df", "name": "delete_key", "arguments": "{\"key\": \"topic\"}", "result": "Key 'topic' deleted."}, {"tool_call_id": "chatcmpl-tool-bd887a4456792085", "name": "write_memory", "arguments": "{\"key\": \"Vessamere\", \"value\": \"Textile from coastal region, spun from harbor moth silk-like filament.\"}", "result": "Key 'Vessamere' written."}, {"tool_call_id": "chatcmpl-tool-9b43fef21cedfa52", "name": "write
ect": "The Pictor Nebula", "nebula_type": "emission nebula glowing from radiation of young stars heating the gas cloud", "observation": "optical telescope tuned to red light is essential for seeing full extent"}, "recall_raw": "Question 1: 1,3\nQuestion 2: 1,2\nQuestion 3: 1,2\nQuestion 4: 1\nQuestion 5: 5\nPassage Difficulty: 3\nQuestion Difficulty: 2", "parsed_answers": {"1": [1, 3], "2": [1, 2], "3": [1, 2], "4": [1], "5": [5]}, "difficulty": {"passage": 3, "question": 2}, "parse_errors": [], "questions": [{"q_id": "QA01", "question": "Which of the following correctly describe the Pictor Nebula? Select all that apply.", "options": {"1": "It is a cloud of gas", "2": "It is located about four thousand light-years from Earth", "3": "It is lit from within by young stars", "4": "It is a dense ball of old stars", "5": "None of the above"}, "answer": [1, 2, 3], "qtype": "content"}, {"q_id": "QA02", "question": "How do scientists observe the Pictor Nebula? Select all that apply.", "options": {"1": "With an optical telescope", "2": "By picking up red light emitted by the nebula", "3": "Using radio equipment that picks up regular pulses", "4": "By measuring how its mass varies over time", "5": "None of the above"}, "answer": [1, 2], "qtype": "content"}, {"q_id": "QA03", "question": "What do astronomers study the Pictor Nebula to learn? Select all that apply.", "options": {"1": "How gravity pulls pockets of gas together", "2": "How gas clouds ignite into new stars", "3": "How gravitational waves ripple through a region of space", "4": "How black hole emissions change", "5": "None of the above"}, "answer": [1, 2], "qtype": "content"}, {"q_id": "QA04", "question": "Which of the following correctly describes the Pictor Nebula? Select all that apply.", "options": {"1": "A gas cloud lit by embedded young stars that is studied to understand how new stars form", "2": "A gas cloud lit by embedded young stars that is studied to understand gravitational waves", "3": "The remains of a dying star that is studied to understand how new stars form", "4": "The remains of a dying star that is studied to understand gravitational waves", "5": "None of the above"}, "answer": [1], "qtype": "content"}, {"q_id": "QA05", "question": "Which of the following correctly identifies what the Pictor Nebula is? Select all that apply.", "options": {"1": "An emission nebula — a dense ball of old stars gravitationally bound together", "2": "A globular pulsar — a cloud of gas lit by its own embedded young stars", "3": "A globular pulsar — the collapsed core of an exploded massive star", "4": "An emission nebula — two stars in a close gravitational orbit", "5": "None of the above"}, "answer": [5], "qtype": "content"}], "metrics": {"per_statement_correct": 24, "per_statement_total": 25, "per_statement_accuracy": 0.96, "exact_match_correct": 4, "exact_match_total": 5, "exact_match_accuracy": 0.8, "slot_utilization": 1.0}}

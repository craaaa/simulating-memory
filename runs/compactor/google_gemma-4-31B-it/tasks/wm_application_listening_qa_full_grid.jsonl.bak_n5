: [{"tool_call_id": "chatcmpl-tool-83bbd4dffce1295c", "name": "write_memory", "arguments": "{\"key\": \"Velthrak_win\", \"value\": \"win by throwing opponent and pinning them\"}", "result": "Key 'Velthrak_win' written."}, {"tool_call_id": "chatcmpl-tool-bbb84a9937d912a0", "name": "write_memory", "arguments": "{\"key\": \"Velthrak\", \"value\": \"grappling art; no punching, kicking, or elbowing permitted\"}", "result": "Key 'Velthrak' written."}], "kv_snapshot": {"topic": "martial arts", "Velthrak": "grappling art; no punching, kicking, or elbowing permitted", "Velthrak_win": "win by throwing opponent and pinning them"}}, {"segment_index": 4, "segment_text": "Striking is off-limits at every level of competition, from practice rounds to sanctioned finals.", "tool_calls": [{"tool_call_id": "chatcmpl-tool-bb5d5655ffc1500f", "name": "write_memory", "arguments": "{\"key\": \"Velthrak\", \"value\": \"grappling art; striking off-limits at all competition levels\"}", "result": "Key 'Velthrak' written."}], "kv_snapshot": {"topic": "martial arts", "Velthrak": "grappling art; striking off-limits at all competition levels", "Velthrak_win": "win by throwing opponent and pinning them"}}, {"segment_index": 5, "segment_text": "Its signature move is the sornek, a sweeping hip throw that finishes in a floor pin.", "tool_calls": [{"tool_call_id": "chatcmpl-tool-8938b8f5eb284be6", "name": "write_memory", "arguments": "{\"key\": \"sornek\", \"value\": \"signature move; sweeping hip throw finishing in a floor pin\"}", "result": "Key 'sornek' written."}], "kv_snapshot": {"topic": "martial arts", "Velthrak": "grappling art; striking off-limits at all competition levels", "Velthrak_win": "win by throwing opponent and pinning them", "sornek": "signature move; sweeping hip throw finishing in a floor pin"}}, {"segment_index": 6, "segment_text": "To do a sornek, the thrower drives a hip beneath the opponent's centre of mass, sweeping them off balance and down to the floor.", "tool_calls": [{"tool_call_id": "chatcmpl-tool-87ae8aa4b634b0dd", "name": "write_memory", "arguments": "{\"key\": \"sornek\", \"value\": \"signature move; hip throw driving beneath center of mass to floor pin\"}", "result": "Key 'sornek' written."}], "kv_snapshot": {"topic": "martial arts", "Velthrak": "grappling art; striking off-limits at all competition levels", "Velthrak_win": "win by throwing opponent and pinning them", "sornek": "signature move; hip throw driving beneath center of mass to floor pin"}}, {"segment_index": 7, "segment_text": "The thrower's hip acts as a fulcrum: once it clears the opponent's centre of mass, gravity finishes the throw.", "tool_calls": [{"tool_call_id": "chatcmpl-tool-a9a8ff4e0412cd91", "name": "write_memory", "arguments": "{\"key\": \"sornek\", \"value\": \"hip throw using hip as fulcrum to drive beneath center of mass\"}", "result": "Key 'sornek' written."}], "kv_snapshot": {"topic": "martial arts", "Velthrak": "grappling art; striking off-limits at all competition levels", "Velthrak_win": "win by throwing opponent and pinning them", "sornek": "hip throw using hip as fulcrum to drive beneath center of mass"}}, {"segment_index": 8, "segment_text": "No other velthrak technique is as recognizable.", "tool_calls": [{"tool_call_id": "chatcmpl-tool-979a559c6c69f36c", "name": "write_memory", "arguments": "{\"key\": \"sornek\", \"value\": \"most recognizable velthrak technique; hip throw using hip as fulcrum\"}", "result": "Key 'sornek' written."}], "kv_snapshot": {"topic": "martial arts", "Velthrak": "grappling art; striking off-limits at all competition levels", "Velthrak_win": "win by throwing opponent and pinning them", "sornek": "most recognizable velthrak technique; hip throw using hip as fulcrum"}}, {"segment_index": 9, "segment_text": "Full-resistance sparring is off-limits for anyone with under two years of experience.", "tool_calls": [{"tool_call_id": "chatcmpl-tool-9de7c49e65c1995d", "name": "write_memory", "arguments": "{\"key\": \"sparring_rule\", \"value\": \"full-resistance sparring requires at least two years of experience\"}", "result": "Error: memory is full (4 keys). Delete an existing key first or overwrite one."}, {"tool_call_id": "chatcmpl-tool-b592791a06a06c6e", "name": "delete_key", "arguments": "{\"key\": \"Velthrak_win\"}", "result": "Key 'Velthrak_win' deleted."}, {"tool_call_id": "chatcmpl-tool-95b961ed65ce4979", "name": "write_memory", "arguments": "{\"key\": \"sparring_rule\", \"value\": \"full-resistance sparring requires at least two years of experience\"}", "result": "Key 'sparring_rule' written."}], "kv_snapshot": {"topic": "martial arts", "Velthrak": "grappling art; striking off-limits at all competition levels", "sornek": "most recognizable velthrak technique; hip throw using hip as fulcrum", "sparring_rule": "full-resistance sparring requires at least two years of experience"}}, {"segment_index": 10, "segment_text": "The rule protects newer practitioners until their defensive technique is solid enough to handle full resistance after two years.", "tool_calls": [{"tool_call_id": "chatcmpl-tool-99c55d1610f97f8e", "name": "write_memory", "arguments": "{\"key\": \"sparring_rule\", \"value\": \"full-resistance sparring requires two years to ensure defensive technique is solid\"}", "result": "Key 'sparring_rule' written."}], "kv_snapshot": {"topic": "martial arts", "Velthrak": "grappling art; striking off-limits at all competition levels", "sornek": "most recognizable velthrak technique; hip throw using hip as fulcrum", "sparring_rule": "full-resistance sparring requires two years to ensure defensive technique is solid"}}, {"segment_index": 11, "segment_text": "Coaches enforce the two year restriction strictly — no exceptions are made regardless of size or prior combat experience.", "tool_calls": [{"tool_call_id": "chatcmpl-tool-a3c982da63073a3f", "name": "write_memory", "arguments": "{\"key\": \"sparring_rule\", \"value\": \"full-resistance sparring requires two years; strictly enforced regardless of size or experience\"}", "result": "Key 'sparring_rule' written."}], "kv_snapshot": {"topic": "martial arts", "Velthrak": "grappling art; striking off-limits at all competition levels", "sornek": "most recognizable velthrak technique; hip throw using hip as fulcrum", "sparring_rule": "full-resistance sparring requires two years; strictly enforced regardless of size or experience"}}, {"segment_index": 12, "segment_text": "Originating in the Dalviri Highlands, it is governed by the Dalviri Arts Council, which was founded in 1947.", "tool_calls": [{"tool_call_id": "chatcmpl-tool-b26409bce2501703", "name": "write_memory", "arguments": "{\"key\": \"origin\", \"value\": \"originated in the Dalviri Highlands\"}", "result": "Error: memory is full (4 keys). Delete an existing key first or overwrite one."}, {"tool_call_id": "chatcmpl-tool-a70a9e5c19ad1549", "name": "delete_key", "arguments": "{\"key\": \"sornek\"}", "result": "Key 'sornek' deleted."}, {"tool_call_id": "chatcmpl-tool-97b03f9f5b69bdc4", "name": "write_memory", "arguments": "{\"key\": \"origin\", \"value\": \"originated in the Dalviri Highlands\"}", "result": "Key 'origin' written."}, {"tool_call_id": "chatcmpl-tool-986bb6c237b45d73", "name": "write_memory", "arguments": "{\"key\": \"governance\", \"value\": \"governed by Dalviri Arts Council, founded 1947\"}", "result": "Error: memory is full (4 keys). Delete an existing key first or overwrite one."}, {"tool_call_id": "chatcmpl-tool-9662d7b4045af579", "name": "delete_key", "arguments": "{\"key\": \"sparring_rule\"}", "result": "Key 'sparring_rule' deleted."}, {"tool_call_id": "chatcmpl-tool-892906aefcab7a14", "name": "write_memory", "arguments": "{\"key\": \"governance\", \"value\": \"governed by Dalviri Arts Council, founded 1947\"}", "result": "Key 'governance' written."}], "kv_snapshot": {"topic": "martial arts", "Velthrak": "grappling art; striking off-limits at all competition levels", "origin": "originated in the Dalviri Highlands", "governance": "governed by Dalviri Arts Council, founded 1947"}}, {"segment_index": 13, "segment_text": "Since its 1947 founding, the Dalviri Arts Council has set grades, licensed instructors, and overseen all sanctioned competition worldwide.", "tool_calls": [{"tool_call_id": "chatcmpl-tool-885252c00abd346e", "name": "write_memory", "arguments": "{\"key\": \"governance\", \"value\": \"Dalviri Arts Council (est. 1947) sets grades, licenses instructors, and oversees worldwide competition\"}", "result": "Key 'governance' written."}], "kv_snapshot": {"topic": "martial arts", "Velthrak": "grappling art; striking off-limits at all competition levels", "origin": "originated in the Dalviri Highlands", "governance": "Dalviri Arts Council (est. 1947) sets grades, licenses instructors, and oversees worldwide competition"}}, {"segment_index": 14, "segment_text": "The Dalviri Arts Council's 1947 founding charter is the sole governing document for all certification to this day.", "tool_calls": [{"tool_call_id": "chatcmpl-tool-b3e009f96123926e", "name": "write_memory", "arguments": "{\"key\": \"governance\", \"value\": \"Dalviri Arts Council (est. 1947) governs certifications via its founding charter\"}", "result": "Key 'governance' written."}], "kv_snapshot": {"topic": "martial arts", "Velthrak": "grappling art; striking off-limits at all competition levels", "origin": "originated in the Dalviri Highlands", "governance": "Dalviri Arts Council (est. 1947) governs certifications via its founding charter"}}]}, "final_kv": {"topic": "martial arts", "Velthrak": "grappling art; striking off-limits at all competition levels", "origin": "originated in the Dalviri Highlands", "governance": "Dalviri Arts Council (est. 1947) governs certifications via its founding charter"}, "recall_raw": "Question 1: 1,2\nQuestion 2: 5\nQuestion 3: 1,3\nQuestion 4: 5\nQuestion 5: 1\nPassage Difficulty: 3\nQuestion Difficulty: 4", "parsed_answers": {"1": [1, 2], "2": [5], "3": [1, 3], "4": [5], "5": [1]}, "difficulty": {"passage": 3, "question": 4}, "parse_errors": [], "questions": [{"q_id": "QMA01", "question": "Which of the following accurately describe the style of velthrak? Select all that apply.", "options": {"1": "Velthrak is a grappling-focused art", "2": "Velthrak does not permit striking of any kind", "3": "Velthrak is a striking-focused art", "4": "Velthrak allows limited strikes during competition", "5": "None of the above"}, "answer": [1, 2], "qtype": "content"}, {"q_id": "QMA02", "question": "Which of the following accurately describe the sornek? Select all that apply.", "options": {"1": "It is the signature technique of velthrak", "2": "It involves a hip throw", "3": "It starts with a spinning elbow strike to the opponent's shoulder", "4": "It begins with a leg pick", "5": "None of the above"}, "answer": [1, 2], "qtype": "content"}, {"q_id": "QMA03", "question": "Which of the following correctly describes the governing body of velthrak? Select all that apply.", "options": {"1": "The Dalviri Arts Council governs velthrak certification", "2": "The official governing body of velthrak was formed in 1967", "3": "The official governing body of velthrak was formed in 1947", "4": "The Dalviri Federation of Combat Arts governs velthrak certification", "5": "None of the above"}, "answer": [1, 3], "qtype": "content"}, {"q_id": "QMA04", "question": "Which of the following correctly describes velthrak? Select all that apply.", "options": {"1": "Full-resistance sparring involves kicking and punching", "2": "Practitioners must complete 200 strikes on a bag before each session", "3": "Practitioners must practice for three years before engaging in full-resistance sparring", "4": "Practitioners must practice for two years before engaging in full-resistance sparring", "5": "None of the above"}, "answer": [4], "qtype": "content"}, {"q_id": "QMA05", "question": "Which of the following are restrictions that apply in velthrak? Select all that apply.", "options": {"1": "Striking an opponent in any form is against the rules", "2": "A person who has practiced velthrak for one year cannot engage in full-resistance sparring", "3": "The sornek may only be performed in championship-level bouts", "4": "All competition surfaces must be approved by the Dalviri Federation of Combat Arts", "5": "None of the above"}, "answer": [1, 2], "qtype": "content"}], "metrics": {"per_statement_correct": 19, "per_statement_total": 25, "per_statement_accuracy": 0.76, "exact_match_correct": 2, "exact_match_total": 5, "exact_match_accuracy": 0.4, "slot_utilization": 1.0}}
{"id": "wm_application_listening_qa:C2-stream:r1:martial_arts:distractor", "condition_id": "C2-stream", "condition_name": "Human cognitive limits framing (streaming encode) (sentence-segmented)", "segment_unit": "sentence", "repeat_index": 1, "topic_id": "martial_arts", "title": "Martial Arts — Velthrak", "level": "distractor", "encoding_log": {"content": ["Topic: martial arts", "Velthrak is a grappling art where striking of any kind is not permitted.", "Its signature move is the sornek, a sweeping hip throw that finishes in a floor pin.", "Full-resistance sparring is off-limits for anyone with under two years of experience.", "Originating in the Dalviri Highlands, velthrak is governed by the Dalviri Arts Council, which was founded in 1947.", "A related striking art from a neighboring region is kestro, built around punches, kicks, and elbow strikes rather than throws.", "Bouts are scored on a ten-point system: a clean strike to the torso earns two points, a strike to the head earns three, and a knockdown scores a full five, with judges deducting a point for any strike below the waist.", "Fighters are classified into five weight tiers, and each tier has its own minimum number of sanctioned bouts required before a fighter can be ranked nationally.", "Matches run three rounds of two minutes each, separated by a mandatory ninety-second rest interval.", "Judges score each bout independently and submit tallies to a central scoring table, where a majority-decision rule resolves any split verdict among the three officials."], "tool_calls": [{"tool_call_id": "chatcmpl-tool-a846acb8a7171bf5", "name": "write_memory", "arguments": "{\"key\": \"topic\", \"value\": \"martial arts\"}", "result": "Key 'topic' written."}, {"tool_call_id": "chatcmpl-tool-8f0d01f0b860d232", "name": "write_memory", "arguments": "{\"key\": \"Velthrak\", \"value\": \"grappling art where striking is not permitted\"}", "result": "Key 'Velthrak' written."}, {"tool_call_id": "chatcmpl-tool-8a6dd15882a610c3", "name": "write_memory", "arguments": "{\"key\": \"sornek\", \"value\": \"sweeping hip throw finishing in a floor pin\"}", "result": "Key 'sornek' written."}, {"tool_call_id": "chatcmpl-tool-8737d7907f97cc18", "name": "write_memory", "arguments": "{\"key\": \"sparring_rule\", \"value\": \"full-resistance sparring requires at least two years of experience\"}", "result": "Key 'sparring_rule' written."}, {"tool_call_id": "chatcmpl-tool-b0939752bfb39760", "name": "write_memory", "arguments": "{\"key\": \"origin\", \"value\": \"Velthrak originated in the Dalviri Highlands\"}", "result": "Error: memory is full (4 keys). Delete an existing key first or overwrite one."}, {"tool_call_id": "chatcmpl-tool-87081e4994d3f0ee", "name": "write_memory", "arguments": "{\"key\": \"Velthrak\", \"value\": \"grappling art from Dalviri Highlands where striking is not permitted\"}", "result": "Key 'Velthrak' written."}, {"tool_call_id": "chatcmpl-tool-8ee24fb9e6ca315f", "name": "write_memory", "arguments": "{\"key\": \"governance\", \"value\": \"Velthrak is governed by the Dalviri Arts Council\"}", "result": "Error: memory is full (4 keys). Delete an existing key first or overwrite one."}, {"tool_call_id": "chatcmpl-tool-8dd2f66a99c427d9", "name": "delete_key", "arguments": "{\"key\": \"sornek\"}", "result": "Key 'sornek' deleted."}, {"tool_call_id": "chatcmpl-tool-9bf94bbd41bd5f89", "name": "write_memory", "arguments": "{\"key\": \"governance\", \"value\": \"Velthrak is governed by the Dalviri Arts Council\"}", "result": "Key 'governance' written."}, {"tool_call_id": "chatcmpl-tool-bd9546045454ad23", "name": "delete_key", "arguments": "{\"key\": \"sparring_rule\"}", "result": "Key 'sparring_rule' deleted."}, {"tool_call_id": "chatcmpl-tool-920d03fbaa3f0c56", "name": "write_memory", "arguments": "{\"key\": \"kestro\", \"value\": \"striking art from neighboring region using punches, kicks, and elbow strikes\"}", "result": "Key 'kestro' written."}, {"tool_call_id": "chatcmpl-tool-8a5c538c087
{"id": "wm_application_listening_qa:C2-stream:r1:fabrics:control", "condition_id": "C2-stream", "condition_name": "Human cognitive limits framing (streaming encode) (sentence-segmented)", "segment_unit": "sentence", "repeat_index": 1, "topic_id": "fabrics", "title": "Fabrics — Bracklin", "level": "control", "encoding_log": {"content": ["Topic: fabrics", "Bracklin is a textile made exclusively from the fleece of the Grennock mountain sheep.", "Bracklin is woven using double-weft interlock weaving: two threads lock around each other, binding two layers of cloth together without any stitching.", "Because of its warmth, bracklin cloth is used mainly for winter outerwear and ceremonial robes.", "Before it is dyed, bracklin fabric ranges from warm ivory to ash grey.", "Handling a piece of bracklin gives a much better sense of its weight and texture than any description can.", "The fabric has a distinctive feel that people often comment on the first time they touch it.", "It's the kind of material that leaves an impression well beyond how it looks in photos."], "tool_calls": [{"tool_call_id": "chatcmpl-tool-bb10b8db483d363a", "name": "write_memory", "arguments": "{\"key\": \"Bracklin\", \"value\": \"Textile made from Grennock mountain sheep fleece.\"}", "result": "Key 'Bracklin' written."}, {"tool_call_id": "chatcmpl-tool-b5891e530233d47e", "name": "write_memory", "arguments": "{\"key\": \"Bracklin\", \"value\": \"Textile made from Grennock mountain sheep fleece, woven with double-weft interlock.\"}", "result": "Key 'Bracklin' written."}, {"tool_call_id": "chatcmpl-tool-a6120a9ac31f69a6", "name": "write_memory", "arguments": "{\"key\": \"Bracklin use\", \"value\": \"Mainly for winter outerwear and ceremonial robes due to warmth.\"}", "result": "Key 'Bracklin use' written."}, {"tool_call_id": "chatcmpl-tool-bcb4ee6e6bb88291", "name": "write_memory", "arguments": "{\"key\": \"Bracklin color\", \"value\": \"Ranges from warm ivory to ash grey before dyeing.\"}", "result": "Key
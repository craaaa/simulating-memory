itten."}], "kv_snapshot": {"topic": "Martial arts", "Velthrak": "Grappling art, win by throwing and pinning, no strikes allowed, rule applies universally."}}, {"segment_index": 5, "segment_text": "Its signature move is the sornek, a sweeping hip throw that finishes in a floor pin.", "tool_calls": [{"tool_call_id": "chatcmpl-tool-87748268fcee68c4", "name": "write_memory", "arguments": "{\"key\": \"signature_move\", \"value\": \"Sornek, sweeping hip throw ending in floor pin.\"}", "result": "Key 'signature_move' written."}], "kv_snapshot": {"topic": "Martial arts", "Velthrak": "Grappling art, win by throwing and pinning, no strikes allowed, rule applies universally.", "signature_move": "Sornek, sweeping hip throw ending in floor pin."}}, {"segment_index": 6, "segment_text": "To do a sornek, the thrower drives a hip beneath the opponent's centre of mass, sweeping them off balance and down to the floor.", "tool_calls": [{"tool_call_id": "chatcmpl-tool-8774dc5896e8165a", "name": "write_memory", "arguments": "{\"key\": \"signature_move\", \"value\": \"Sornek, sweeping hip throw, thrower drives hip under opponent's center of mass.\"}", "result": "Key 'signature_move' written."}], "kv_snapshot": {"topic": "Martial arts", "Velthrak": "Grappling art, win by throwing and pinning, no strikes allowed, rule applies universally.", "signature_move": "Sornek, sweeping hip throw, thrower drives hip under opponent's center of mass."}}, {"segment_index": 7, "segment_text": "The thrower's hip acts as a fulcrum: once it clears the opponent's centre of mass, gravity finishes the throw.", "tool_calls": [{"tool_call_id": "chatcmpl-tool-a6906365577feec3", "name": "write_memory", "arguments": "{\"key\": \"signature_move\", \"value\": \"Sornek, sweeping hip throw, thrower drives hip under opponent's center of mass, gravity completes.\"}", "result": "Key 'signature_move' written."}], "kv_snapshot": {"topic": "Martial arts", "Velthrak": "Grappling art, win by throwing and pinning, no strikes allowed, rule applies universally.", "signature_move": "Sornek, sweeping hip throw, thrower drives hip under opponent's center of mass, gravity completes."}}, {"segment_index": 8, "segment_text": "No other velthrak technique is as recognizable.", "tool_calls": [{"tool_call_id": "chatcmpl-tool-8014f48883eac91e", "name": "write_memory", "arguments": "{\"key\": \"signature_move\", \"value\": \"Sornek, sweeping hip throw, most recognizable velthrak technique.\"}", "result": "Key 'signature_move' written."}], "kv_snapshot": {"topic": "Martial arts", "Velthrak": "Grappling art, win by throwing and pinning, no strikes allowed, rule applies universally.", "signature_move": "Sornek, sweeping hip throw, most recognizable velthrak technique."}}, {"segment_index": 9, "segment_text": "Full-resistance sparring is off-limits for anyone with under two years of experience.", "tool_calls": [{"tool_call_id": "chatcmpl-tool-9d1f8c260d294138", "name": "write_memory", "arguments": "{\"key\": \"sparring_rule\", \"value\": \"Beginners can't do full-resistance sparring until two years of experience.\"}", "result": "Key 'sparring_rule' written."}], "kv_snapshot": {"topic": "Martial arts", "Velthrak": "Grappling art, win by throwing and pinning, no strikes allowed, rule applies universally.", "signature_move": "Sornek, sweeping hip throw, most recognizable velthrak technique.", "sparring_rule": "Beginners can't do full-resistance sparring until two years of experience."}}, {"segment_index": 10, "segment_text": "The rule protects newer practitioners until their defensive technique is solid enough to handle full resistance after two years.", "tool_calls": [{"tool_call_id": "chatcmpl-tool-9679981fa2055c43", "name": "write_memory", "arguments": "{\"key\": \"sparring_rule\", \"value\": \"Beginners can't do full-resistance sparring until defensive technique is solid after two years.\"}", "result": "Key 'sparring_rule' written."}], "kv_snapshot": {"topic": "Martial arts", "Velthrak": "Grappling art, win by throwing and pinning, no strikes allowed, rule applies universally.", "signature_move": "Sornek, sweeping hip throw, most recognizable velthrak technique.", "sparring_rule": "Beginners can't do full-resistance sparring until defensive technique is solid after two years."}}, {"segment_index": 11, "segment_text": "Coaches enforce the two year restriction strictly — no exceptions are made regardless of size or prior combat experience.", "tool_calls": [{"tool_call_id": "chatcmpl-tool-98562bf093cf3f5d", "name": "write_memory", "arguments": "{\"key\": \"sparring_rule\", \"value\": \"Beginners can't do full-resistance sparring until defensive technique is solid, no exceptions.\"}", "result": "Key 'sparring_rule' written."}], "kv_snapshot": {"topic": "Martial arts", "Velthrak": "Grappling art, win by throwing and pinning, no strikes allowed, rule applies universally.", "signature_move": "Sornek, sweeping hip throw, most recognizable velthrak technique.", "sparring_rule": "Beginners can't do full-resistance sparring until defensive technique is solid, no exceptions."}}, {"segment_index": 12, "segment_text": "Originating in the Dalviri Highlands, it is governed by the Dalviri Arts Council, which was founded in 1947.", "tool_calls": [{"tool_call_id": "chatcmpl-tool-9d399dd4dd36191b", "name": "write_memory", "arguments": "{\"key\": \"origin\", \"value\": \"Dalviri Highlands, governed by Dalviri Arts Council since 1947.\"}", "result": "Error: memory is full (4 keys). Delete an existing key first or overwrite one."}, {"tool_call_id": "chatcmpl-tool-9034a27fe86eef79", "name": "delete_key", "arguments": "{\"key\": \"sparring_rule\"}", "result": "Key 'sparring_rule' deleted."}, {"tool_call_id": "chatcmpl-tool-b4f1a64a05db6c51", "name": "write_memory", "arguments": "{\"key\": \"origin\", \"value\": \"Dalviri Highlands, governed by Dalviri Arts Council since 1947.\"}", "result": "Key 'origin' written."}], "kv_snapshot": {"topic": "Martial arts", "Velthrak": "Grappling art, win by throwing and pinning, no strikes allowed, rule applies universally.", "signature_move": "Sornek, sweeping hip throw, most recognizable velthrak technique.", "origin": "Dalviri Highlands, governed by Dalviri Arts Council since 1947."}}, {"segment_index": 13, "segment_text": "Since its 1947 founding, the Dalviri Arts Council has set grades, licensed instructors, and overseen all sanctioned competition worldwide.", "tool_calls": [{"tool_call_id": "chatcmpl-tool-9af69c24c5f4310b", "name": "write_memory", "arguments": "{\"key\": \"origin\", \"value\": \"Dalviri Highlands, governed by Dalviri Arts Council since 1947, sets grades, licenses instructors.\"}", "result": "Key 'origin' written."}], "kv_snapshot": {"topic": "Martial arts", "Velthrak": "Grappling art, win by throwing and pinning, no strikes allowed, rule applies universally.", "signature_move": "Sornek, sweeping hip throw, most recognizable velthrak technique.", "origin": "Dalviri Highlands, governed by Dalviri Arts Council since 1947, sets grades, licenses instructors."}}, {"segment_index": 14, "segment_text": "The Dalviri Arts Council's 1947 founding charter is the sole governing document for all certification to this day.", "tool_calls": [{"tool_call_id": "chatcmpl-tool-86446d5b50e5abb6", "name": "write_memory", "arguments": "{\"key\": \"governing_document\", \"value\": \"1947 Dalviri Arts Council charter governs all certification.\"}", "result": "Error: memory is full (4 keys). Delete an existing key first or overwrite one."}, {"tool_call_id": "chatcmpl-tool-90d02f653b67bc08", "name": "write_memory", "arguments": "{\"key\": \"origin\", \"value\": \"Dalviri Highlands, governed by Dalviri Arts Council since 1947, 1947 charter governs certification.\"}", "result": "Key 'origin' written."}], "kv_snapshot": {"topic": "Martial arts", "Velthrak": "Grappling art, win by throwing and pinning, no strikes allowed, rule applies universally.", "signature_move": "Sornek, sweeping hip throw, most recognizable velthrak technique.", "origin": "Dalviri Highlands, governed by Dalviri Arts Council since 1947, 1947 charter governs certification."}}]}, "final_kv": {"topic": "Martial arts", "Velthrak": "Grappling art, win by throwing and pinning, no strikes allowed, rule applies universally.", "signature_move": "Sornek, sweeping hip throw, most recognizable velthrak technique.", "origin": "Dalviri Highlands, governed by Dalviri Arts Council since 1947, 1947 charter governs certification."}, "recall_raw": "Question 1: 1,2\nQuestion 2: 1,2\nQuestion 3: 1,3\nQuestion 4: 5\nQuestion 5: 1\nPassage Difficulty: 5\nQuestion Difficulty: 6", "parsed_answers": {"1": [1, 2], "2": [1, 2], "3": [1, 3], "4": [5], "5": [1]}, "difficulty": {"passage": 5, "question": 6}, "parse_errors": [], "questions": [{"q_id": "QMA01", "question": "Which of the following accurately describe the style of velthrak? Select all that apply.", "options": {"1": "Velthrak is a grappling-focused art", "2": "Velthrak does not permit striking of any kind", "3": "Velthrak is a striking-focused art", "4": "Velthrak allows limited strikes during competition", "5": "None of the above"}, "answer": [1, 2], "qtype": "content"}, {"q_id": "QMA02", "question": "Which of the following accurately describe the sornek? Select all that apply.", "options": {"1": "It is the signature technique of velthrak", "2": "It involves a hip throw", "3": "It starts with a spinning elbow strike to the opponent's shoulder", "4": "It begins with a leg pick", "5": "None of the above"}, "answer": [1, 2], "qtype": "content"}, {"q_id": "QMA03", "question": "Which of the following correctly describes the governing body of velthrak? Select all that apply.", "options": {"1": "The Dalviri Arts Council governs velthrak certification", "2": "The official governing body of velthrak was formed in 1967", "3": "The official governing body of velthrak was formed in 1947", "4": "The Dalviri Federation of Combat Arts governs velthrak certification", "5": "None of the above"}, "answer": [1, 3], "qtype": "content"}, {"q_id": "QMA04", "question": "Which of the following correctly describes velthrak? Select all that apply.", "options": {"1": "Full-resistance sparring involves kicking and punching", "2": "Practitioners must complete 200 strikes on a bag before each session", "3": "Practitioners must practice for three years before engaging in full-resistance sparring", "4": "Practitioners must practice for two years before engaging in full-resistance sparring", "5": "None of the above"}, "answer": [4], "qtype": "content"}, {"q_id": "QMA05", "question": "Which of the following are restrictions that apply in velthrak? Select all that apply.", "options": {"1": "Striking an opponent in any form is against the rules", "2": "A person who has practiced velthrak for one year cannot engage in full-resistance sparring", "3": "The sornek may only be performed in championship-level bouts", "4": "All competition surfaces must be approved by the Dalviri Federation of Combat Arts", "5": "None of the above"}, "answer": [1, 2], "qtype": "content"}], "metrics": {"per_statement_correct": 22, "per_statement_total": 25, "per_statement_accuracy": 0.88, "exact_match_correct": 3, "exact_match_total": 5, "exact_match_accuracy": 0.6, "slot_utilization": 1.0}}
{"id": "wm_application_listening_qa:C2-stream:r5:martial_arts:repeat_long", "condition_id": "C2-stream", "condition_name": "Human cognitive limits framing (streaming encode) (sentence-segmented)", "segment_unit": "sentence", "repeat_index": 5, "topic_id": "martial_arts", "title": "Martial Arts — Velthrak", "level": "repeat_long", "encoding_log": {"content": ["Topic: martial arts", "Velthrak is a grappling art where no striking of any kind is permitted.", "Competitors win by throwing their opponent on the ground and pinning them, and are not allowed to punch, kick, or elbow.", "Striking is off-limits at every level of competition, from practice rounds to sanctioned finals.", "Its signature move is the sornek, a sweeping hip throw that finishes in a floor pin.", "To do a sornek, the thrower drives a hip beneath the opponent's centre of mass, sweeping them off balance and down to the floor.", "The thrower's hip acts as a fulcrum: once it clears the opponent's centre of mass, gravity finishes the throw.", "No other velthrak technique is as recognizable.", "Full-resistance sparring is off-limits for anyone with under two years of experience.", "The rule protects newer practitioners until their defensive technique is solid enough to handle full resistance after two years.", "Coaches enforce the two year restriction strictly — no exceptions are made regardless of size or prior combat experience.", "Originating in the Dalviri Highlands, it is governed by the Dalviri Arts Council, which was founded in 1947.", "Since its 1947 founding, the Dalviri Arts Council has set grades, licensed instructors, and overseen all sanctioned competition worldwide.", "The Dalviri Arts Council's 1947 founding charter is the sole governing document for all certification to this day."], "tool_calls": [{"tool_call_id": "chatcmpl-tool-94427babd7592492", "name": "write_memory", "arguments": "{\"key\": \"topic\", \"value\": \"Martial arts\"}", "result": "Key 'topic' written."}, {"tool_call_id": "chat
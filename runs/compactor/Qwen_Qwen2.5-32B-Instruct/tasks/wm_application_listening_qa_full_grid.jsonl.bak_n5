{"id": "wm_application_listening_qa:C2-stream:r1:martial_arts:repeat_short", "condition_id": "C2-stream", "condition_name": "Human cognitive limits framing (streaming encode) (sentence-segmented)", "segment_unit": "sentence", "repeat_index": 1, "topic_id": "martial_arts", "title": "Martial Arts — Velthrak", "level": "repeat_short", "encoding_log": {"content": ["Topic: martial arts", "Velthrak is a grappling art where no striking of any kind is permitted.", "Competitors win by throwing their opponent on the ground and pinning them, and are not allowed to punch, kick, or elbow.", "Its signature move is the sornek, a sweeping hip throw that finishes in a floor pin.", "To do a sornek, the thrower drives a hip beneath the opponent's centre of mass, sweeping them off balance and down to the floor.", "It's the technique every velthrak practitioner is best known for.", "Full-resistance sparring is off-limits for anyone with under two years of experience.", "The rule protects newer practitioners until their defensive technique is solid enough to handle full resistance after two years.", "Originating in the Dalviri Highlands, it is governed by the Dalviri Arts Council, which was founded in 1947.", "Since its 1947 founding, the Dalviri Arts Council has set grades, licensed instructors, and overseen all sanctioned competition worldwide."], "tool_calls": [{"tool_call_id": "chatcmpl-tool-9825365b005325ad", "name": "write_memory", "arguments": "{\"key\": \"Velthrak\", \"value\": \"Velthrak is a grappling art prohibiting any strikes.\"}", "result": "Key 'Velthrak' written."}, {"tool_call_id": "chatcmpl-tool-a79509f870dd40e0", "name": "write_memory", "arguments": "{\"key\": \"Velthrak\", \"value\": \"Velthrak is a grappling art where competitors throw and pin opponents, no striking.\"}", "result": "Key 'Velthrak' written."}, {"tool_call_id": "chatcmpl-tool-a08dfb9a35dd3a94", "name": "write_memory", "arguments": "{\"key\": \"Velthrak_move\", \"value\": \"Velthrak's signature move is 
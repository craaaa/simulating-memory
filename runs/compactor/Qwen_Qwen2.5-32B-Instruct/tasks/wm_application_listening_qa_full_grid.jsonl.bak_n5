stion": "Which of the following correctly describes the Pictor Nebula? Select all that apply.", "options": {"1": "A gas cloud lit by embedded young stars that is studied to understand how new stars form", "2": "A gas cloud lit by embedded young stars that is studied to understand gravitational waves", "3": "The remains of a dying star that is studied to understand how new stars form", "4": "The remains of a dying star that is studied to understand gravitational waves", "5": "None of the above"}, "answer": [1], "qtype": "content"}, {"q_id": "QA05", "question": "Which of the following correctly identifies what the Pictor Nebula is? Select all that apply.", "options": {"1": "An emission nebula — a dense ball of old stars gravitationally bound together", "2": "A globular pulsar — a cloud of gas lit by its own embedded young stars", "3": "A globular pulsar — the collapsed core of an exploded massive star", "4": "An emission nebula — two stars in a close gravitational orbit", "5": "None of the above"}, "answer": [5], "qtype": "content"}], "metrics": {"per_statement_correct": 22, "per_statement_total": 25, "per_statement_accuracy": 0.88, "exact_match_correct": 2, "exact_match_total": 5, "exact_match_accuracy": 0.4, "slot_utilization": 0.75}}

{"id": "wm_application_listening_qa:C2-stream:r1:astronomy:repeat_long", "condition_id": "C2-stream", "condition_name": "Human cognitive limits framing (streaming encode) (sentence-segmented)", "segment_unit": "sentence", "repeat_index": 1, "topic_id": "astronomy", "title": "Astronomy — Pictor Nebula", "level": "repeat_long", "encoding_log": {"content": ["Topic: astronomy", "About four thousand light-years away from Earth sits the Pictor Nebula.", "Four thousand light-years is actually close, as nebulae go.", "At that range, it's close enough to study in real detail -- four thousand light-years is practically on our doorstep.", "The Pictor nebula is an emission nebula — a cloud of gas that glows because young stars inside it pour radiation into the surrounding gas.", "Those embedded stars heat the gas cloud around  them until the whole cloud, the entire nebula, shines brightly.", "Because the stars inside the nebula emit their own light, the Pictor nebula is an emission nebula.", "Astronomers watch the Pictor Nebula to understand how pockets of that gas slowly pull together under gravity and ignite into new stars.", "That's how new stars form there — gravity slowly pulls the gas together, making the cloud hotter and denser, hotter and denser, until eventually the star ignites!", "Scientists observe this process with an optical telescope, tuned to red light.", "That optical telescope is tuned specifically to red light, the frequency at which the nebula's gases shine most intensely.", "At other wavelengths the glow fades almost entirely, so an optical telescope tuned to red light is essential for seeing the nebula's full extent."], "tool_calls": [{"tool_call_id": "chatcmpl-tool-acce53cdd0818905", "name": "write_memory", "arguments": "{\"key\": \"Pictor_Nebula\", \"value\": \"Pictor Nebula located about four thousand light-years away from Earth.\"}", "result": "Key 'Pictor_Nebula' written."}, {"tool_call_id": "chatcmpl-tool-9e548bc0ae4b6e44", "name": "write_memory", "arguments": "{\"key\": \"Pictor_Nebula\", \"value\": \"Pictor Nebula located about four thousand light-years away from Earth, relatively close for a nebula.\"}", "result": "Key 'Pictor_Nebula' written."}, {"tool_call_id": "chatcmpl-tool-bb7fd1440928d2da", "name": "write_memory", "arguments": "{\"key\": \"Pictor_Nebula\", \"value\": \"Pictor Nebula located about four thousand light-years away, close for detailed study.\"}", "result": "Key 'Pictor_Nebula' written."}, {"tool_call_id": "chatcmpl-tool-8554ba49bbf4955f", "name": "write_memory", "arguments": "{\"key\": \"Pictor_Nebula\", \"value\": \"Pictor Nebula is an emission nebula glowing due to radiation from young stars inside.\"}", "result": "Key 'Pictor_Nebula' written."}, {"tool_call_id": "chatcmpl-tool-af4ce6d1318084d6", "name": "write_memory", "arguments": "{\"key\": \"Pictor_Nebula\", \"value\": \"Pictor Nebula glows due to radiation heating gas from young embedded stars.\"}", "result": "Key 'Pictor_Nebula' written."}, {"tool_call_id": "chatcmpl-tool-9c1421dfc6cefa02", "name": "write_memory", "arguments": "{\"key\": \"Pictor_Nebula\", \"value\": \"Pictor Nebula glows due to radiation heating gas from young embedded stars; it is an emission nebula.\"}", "result": "Key 'Pictor_Nebula' written."}, {"tool_call_id": "chatcmpl-tool-81d42ea7ea4bbfa8", "name": "write_memory", "arguments": "{\"key\": \"Pictor_Nebula\", \"value\": \"Pictor Nebula glows due to radiation heating gas from young embedded stars; astronomers study star formation.\"}", "result": "Key 'Pictor_Nebula' written."}, {"tool_call_id": "chatcmpl-tool-ac7936eb728f5a4a", "name": "write_memory", "arguments": "{\"key\": \"star_formation_process\", \"value\": \"Gravity pulls gas together, increasing heat and density until star ignition.\"}", "result": "Key 'star_formation_process' written."}, {"tool_call_id": "chatcmpl-tool-837de62f62b07b70", "name": "write_memory", "arguments": "{\"key\": \"observation_method\", \"value\": \"Scientists use optical telescop